{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-entity-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/{entity:regex(^(Products|Categories|Brands|Colors|Sizes|ProductPrices|ProductImages|Measurements|Currencies|PriceTypes|DefaultSlider1|DefaultTrend|DefaultTrends|BestSeller|BestSellers|NewProducts|InstagramPost|InstagramPosts)$)}/{**catch-all}"
        }
      },
      "catalog-prefix-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/catalog" },
          { "PathPrefix": "/api" }
        ]
      },
      "discount-entity-route": {
        "ClusterId": "discount-cluster",
        "Match": { "Path": "/api/Discounts/{**catch-all}" }
      },
      "discount-prefix-route": {
        "ClusterId": "discount-cluster",
        "Match": { "Path": "/api/discount/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/discount" },
          { "PathPrefix": "/api" }
        ]
      },
      "location-entity-route": {
        "ClusterId": "location-cluster",
        "Match": {
          "Path": "/api/{entity:regex(^(Cities|City|Districts|District|Neighborhoods|Neighborhood|UserAddresses|UserAddress|Dealers|Dealer|DealerAddress|ContactInfos|ContactInfo|Country|Countries|Company|Branch|BranchAddress|Warehouse|Iletisim|BultenAboneligi)$)}/{**catch-all}"
        }
      },
      "location-prefix-route": {
        "ClusterId": "location-cluster",
        "Match": { "Path": "/api/location/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/location" },
          { "PathPrefix": "/api" }
        ]
      },
      "order-entity-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/{entity:regex(^(Orderings|Addresses|OrderDetails)$)}/{**catch-all}"
        }
      },
      "order-prefix-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/order/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/order" },
          { "PathPrefix": "/api" }
        ]
      },
      "b2b-entity-route": {
        "ClusterId": "b2b-cluster",
        "Match": { "Path": "/api/DealerFinancials/{**catch-all}" }
      },
      "b2b-prefix-route": {
        "ClusterId": "b2b-cluster",
        "Match": { "Path": "/api/b2b/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/b2b" },
          { "PathPrefix": "/api" }
        ]
      },
      "basket-entity-route": {
        "ClusterId": "basket-cluster",
        "Match": { "Path": "/api/Baskets/{**catch-all}" }
      },
      "basket-prefix-route": {
        "ClusterId": "basket-cluster",
        "Match": { "Path": "/api/basket/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/basket" },
          { "PathPrefix": "/api" }
        ]
      },
      "favorite-entity-route": {
        "ClusterId": "favorite-cluster",
        "Match": { "Path": "/api/Favorites/{**catch-all}" }
      },
      "favorite-prefix-route": {
        "ClusterId": "favorite-cluster",
        "Match": { "Path": "/api/favorite/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/favorite" },
          { "PathPrefix": "/api" }
        ]
      },
      "rental-entity-route": {
        "ClusterId": "rental-cluster",
        "Match": { "Path": "/api/Rentals/{**catch-all}" }
      },
      "rental-prefix-route": {
        "ClusterId": "rental-cluster",
        "Match": { "Path": "/api/rental/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/rental" },
          { "PathPrefix": "/api" }
        ]
      },
      "payment-entity-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/Payments/{**catch-all}" }
      },
      "payment-prefix-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payment/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/payment" },
          { "PathPrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "http://localhost:7301" } }
      },
      "discount-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "https://localhost:7302" } }
      },
      "location-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "https://localhost:7303" } }
      },
      "order-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "https://localhost:7304" } }
      },
      "b2b-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "http://localhost:7305" } }
      },
      "basket-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "http://localhost:7306" } }
      },
      "favorite-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "http://localhost:7307" } }
      },
      "rental-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "http://localhost:7308" } }
      },
      "payment-cluster": {
        "HttpClient": { "DangerousAcceptAnyServerCertificateValidator": true },
        "Destinations": { "destination1": { "Address": "http://localhost:7309" } }
      }
    }
  }
}
