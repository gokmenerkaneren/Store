@model Store.DtoLayer.BasketDtos.BasketTotalDto
@{
    ViewData["Title"] = "Sepetim";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="breadcrumbs mt-15">
    <div class="container">
        <ul class="list-unstyled d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
            <li><a href="/Default/Index">Anasayfa</a></li>
            <li><span>Sepetim</span></li>
        </ul>
    </div>
</div>

<h1 class="h3 mt-20 mb-30 text-center">Sepetim</h1>

<div class="cart mb-60 mb-lg-70">
    <div class="container">
        @if (Model == null || Model.BasketItems == null || !Model.BasketItems.Any())
        {
            <div class="text-center py-50 my-30 border rounded bg-white shadow-sm p-4 js-cart-page-empty-box">
                <div class="mb-20">
                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-theme-165" style="width: 64px; height: 64px; fill: #adb5bd;" viewBox="0 0 24 24">
                        <path d="M4.741 21.654a.601.601 0 0 1-.186-.439v-15h-1.25a.598.598 0 0 1-.439-.186.597.597 0 0 1-.186-.439.6.6 0 0 1 .186-.439.604.604 0 0 1 .439-.186h5v-2.5a.6.6 0 0 1 .186-.439.598.598 0 0 1 .439-.186h6.25c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439v2.5h5c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186h-1.25v15a.6.6 0 0 1-.186.439.601.601 0 0 1-.439.186H5.18a.598.598 0 0 1-.439-.186zM18.305 6.215h-12.5V20.59h12.5V6.215zM9.37 9.525a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965a.6.6 0 0 1 .186-.439.594.594 0 0 1 .438-.186c.169 0 .316.062.44.185zm.185-4.56h5V3.09h-5v1.875zm2.94 4.56a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965a.6.6 0 0 1 .186-.439.594.594 0 0 1 .438-.186c.169 0 .316.062.44.185zm2.246 0a.604.604 0 0 1 .439-.186c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965c0-.169.062-.316.186-.44z"/>
                    </svg>
                </div>
                <h2 class="h4 mb-15">Alışveriş Sepetiniz Boş</h2>
                <p class="text-muted mb-30">Sepetinizde henüz ürün bulunmamaktadır. Alışverişe başlamak için hemen ürünlerimizi keşfedin.</p>
                <a href="/Default/Index" class="btn btn--secondary px-40 py-15 text-uppercase font-weight-bold">ALIŞVERİŞE BAŞLA</a>
            </div>
        }
        else
        {
            <div class="row" id="cart-main-container">
                <div class="col-lg-8 col-xl-9">
                    <div class="cart__items">
                        <div class="cart__head pb-10 border-bottom">
                            <div class="row">
                                <div class="d-none d-sm-block col-sm-5 col-lg-4 col-xl-7">
                                    <label class="m-0 font-weight-bold text-uppercase">ÜRÜN</label>
                                </div>
                                <div class="col-sm-7 col-lg-8 col-xl-5">
                                    <div class="row">
                                        <div class="col col-sm-4 col-lg-4">
                                            <label class="m-0 font-weight-bold text-uppercase">FİYAT</label>
                                        </div>
                                        <div class="col col-sm-4 col-lg-4 text-center text-lg-left">
                                            <label class="m-0 font-weight-bold text-uppercase">ADET</label>
                                        </div>
                                        <div class="col col-sm-4 col-lg-4 text-right">
                                            <label class="m-0 font-weight-bold text-uppercase">TOPLAM</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @foreach (var item in Model.BasketItems)
                        {
                            var lineTotal = item.Price * item.Quantity;
                            var imgUrl = string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/Default/placeholder.jpg" : item.ImageUrl;
                            <div class="py-20 border-bottom js-cart-page-item-row" data-product-id="@item.ProductId" data-unit-price="@item.Price">
                                <div class="row d-flex align-items-center flex-column flex-sm-row">
                                    <div class="col-sm-5 col-lg-4 col-xl-7 d-flex align-items-center mb-20 mb-sm-0">
                                        <a href="/Sepetim/RemoveItem?productId=@item.ProductId" 
                                           class="mr-20 js-cart-page-remove text-muted" 
                                           data-product-id="@item.ProductId"
                                           title="Ürünü Sepetten Kaldır"
                                           style="cursor: pointer;">
                                            <i>
                                                <svg aria-hidden="true" focusable="false" role="presentation"
                                                     class="icon icon-theme-165" viewBox="0 0 24 24" style="width: 18px; height: 18px; fill: #999; transition: fill 0.2s ease;">
                                                    <path d="M4.741 21.654a.601.601 0 0 1-.186-.439v-15h-1.25a.598.598 0 0 1-.439-.186.597.597 0 0 1-.186-.439.6.6 0 0 1 .186-.439.604.604 0 0 1 .439-.186h5v-2.5a.6.6 0 0 1 .186-.439.598.598 0 0 1 .439-.186h6.25c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439v2.5h5c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186h-1.25v15a.6.6 0 0 1-.186.439.601.601 0 0 1-.439.186H5.18a.598.598 0 0 1-.439-.186zM18.305 6.215h-12.5V20.59h12.5V6.215zM9.37 9.525a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965a.6.6 0 0 1 .186-.439.594.594 0 0 1 .438-.186c.169 0 .316.062.44.185zm.185-4.56h5V3.09h-5v1.875zm2.94 4.56a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965a.6.6 0 0 1 .186-.439.594.594 0 0 1 .438-.186c.169 0 .316.062.44.185zm2.246 0a.604.604 0 0 1 .439-.186c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965c0-.169.062-.316.186-.44z"/>
                                                </svg>
                                            </i>
                                        </a>
                                        <div class="d-flex align-items-center align-items-sm-start align-items-xl-center flex-sm-column flex-xl-row w-100">
                                            <a href="/Product/Index/@item.ProductId" class="d-block mb-sm-15 mb-xl-0 mr-20 mr-sm-0 mr-xl-20 flex-shrink-0" style="width: 80px; min-width: 80px; text-decoration: none;">
                                                <div style="width: 80px; height: 100px; border-radius: 6px; overflow: hidden; border: 1px solid #e5e5e5; background-color: #f8f8f8; display: flex; align-items: center; justify-content: center;">
                                                    <img src="@imgUrl" 
                                                         alt="@item.ProductName" 
                                                         style="width: 100%; height: 100%; object-fit: cover; display: block;" 
                                                         onerror="this.onerror=null; this.src='/images/Default/placeholder.jpg';" />
                                                </div>
                                            </a>
                                            <div class="d-flex flex-column">
                                                <a href="/Product/Index/@item.ProductId" class="font-weight-bold text-dark" style="text-decoration: none;">@item.ProductName</a>
                                                <div class="mt-5">
                                                    @if (item.IsRental)
                                                    {
                                                        <span class="badge badge-warning text-dark py-1 px-2" style="font-size: 11px;">Kiralama</span>
                                                        @if (item.RentalStartDate.HasValue && item.RentalEndDate.HasValue)
                                                        {
                                                            <p class="small text-muted mb-0 mt-1">
                                                                Tarih: @item.RentalStartDate.Value.ToString("dd.MM.yyyy") - @item.RentalEndDate.Value.ToString("dd.MM.yyyy")
                                                            </p>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-light border text-secondary py-1 px-2" style="font-size: 11px;">Satış</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-7 col-lg-8 col-xl-5">
                                        <div class="row d-flex align-items-center">
                                            <div class="col col-sm-4 col-lg-4">
                                                <span class="price font-weight-bold">@item.Price.ToString("N2") ₺</span>
                                            </div>
                                            <div class="col col-sm-4 col-lg-4">
                                                <div class="d-inline-flex align-items-center border rounded" style="background: #f8f9fa;">
                                                    <button type="button" class="btn btn-sm py-0 px-2 js-cart-page-minus" data-product-id="@item.ProductId" style="border: none; background: transparent; font-weight: bold; height: 32px; width: 30px; cursor: pointer;">-</button>
                                                    <input type="number" 
                                                           class="mb-0 text-center js-cart-page-qty border-0" 
                                                           data-product-id="@item.ProductId"
                                                           value="@item.Quantity" 
                                                           min="1" 
                                                           max="99" 
                                                           style="width: 42px; height: 32px; padding: 0; outline: none; background: transparent; font-weight: 600;">
                                                    <button type="button" class="btn btn-sm py-0 px-2 js-cart-page-plus" data-product-id="@item.ProductId" style="border: none; background: transparent; font-weight: bold; height: 32px; width: 30px; cursor: pointer;">+</button>
                                                </div>
                                            </div>
                                            <div class="col col-sm-4 col-lg-4 text-right">
                                                <span class="price font-weight-bold text-dark js-cart-page-row-total" data-product-id="@item.ProductId">@lineTotal.ToString("N2") ₺</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Kargo Bilgilendirme Çubuğu -->
                    <div class="pt-20">
                        <div class="free-shipping position-relative px-6 py-3 text-lg-left js-free-shipping" style="background: #e8f5e9; border: 1px solid #c8e6c9; border-radius: 4px;">
                            <div class="free-shipping__text position-relative font-weight-bold text-success d-flex align-items-center">
                                <i class="mr-3">
                                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-theme-127" viewBox="0 0 24 24" style="width: 20px; height: 20px; fill: currentColor;">
                                        <path d="M21.648 12.672c.104.052.188.13.254.234a.62.62 0 0 1 .098.332v5a.602.602 0 0 1-.186.439.601.601 0 0 1-.439.186h-2.559a3.043 3.043 0 0 1-1.074 1.787 3.03 3.03 0 0 1-1.992.713c-.756 0-1.42-.238-1.992-.713a3.028 3.028 0 0 1-1.074-1.787h-1.309a.597.597 0 0 1-.439-.186.6.6 0 0 1-.186-.439V4.488H2.625a.597.597 0 0 1-.439-.186A.597.597 0 0 1 2 3.863a.6.6 0 0 1 .186-.439.597.597 0 0 1 .439-.186h8.75a.6.6 0 0 1 .439.186c.123.124.186.27.186.439v2.5h5a.614.614 0 0 1 .586.41l1.797 4.766 2.265 1.133zM9.314 9.674c.123.124.186.27.186.439a.602.602 0 0 1-.186.439.601.601 0 0 1-.439.186h-3.75a.597.597 0 0 1-.439-.186.597.597 0 0 1-.186-.439.6.6 0 0 1 .186-.439.598.598 0 0 1 .439-.186h3.75a.6.6 0 0 1 .439.186zm0 3.125c.123.124.186.27.186.439a.602.602 0 0 1-.186.439.601.601 0 0 1-.439.186h-2.5a.597.597 0 0 1-.439-.186.6.6 0 0 1-.186-.439.6.6 0 0 1 .186-.439.598.598 0 0 1 .439-.186h2.5a.6.6 0 0 1 .439.186zm11.436 4.814v-3.984l-2.148-1.074a.635.635 0 0 1-.195-.146.557.557 0 0 1-.117-.205l-1.719-4.59H12v10h.684a3.033 3.033 0 0 1 1.074-1.787 3.026 3.026 0 0 1 1.992-.713 3.03 3.03 0 0 1 1.992.713 3.041 3.041 0 0 1 1.074 1.787h1.934zm-3.936-6.064c.123.124.186.27.186.439a.602.602 0 0 1-.186.439.601.601 0 0 1-.439.186h-2.5a.597.597 0 0 1-.439-.186.6.6 0 0 1-.186-.439v-2.5a.6.6 0 0 1 .186-.439.598.598 0 0 1 .439-.186.6.6 0 0 1 .439.186c.123.124.186.27.186.439v1.875h1.875a.6.6 0 0 1 .439.186zm.264 8.017a1.81 1.81 0 0 0 .547-1.328 1.81 1.81 0 0 0-.547-1.328 1.812 1.812 0 0 0-1.328-.547 1.81 1.81 0 0 0-1.328.547 1.808 1.808 0 0 0-.547 1.328c0 .521.182.964.547 1.328.364.365.807.547 1.328.547s.963-.182 1.328-.547z"/>
                                    </svg>
                                </i>
                                <span>Tüm siparişlerinizde Ücretsiz Standart Kargo Fırsatı!</span>
                            </div>
                        </div>
                    </div>

                    <!-- Alt Butonlar -->
                    <div class="d-flex pt-25 align-items-center flex-wrap">
                        <a href="/Default/Index" class="btn btn--text">
                            <i class="mb-4 mr-4">
                                <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-theme-012" viewBox="0 0 24 24" style="width: 16px; height: 16px; fill: currentColor;">
                                    <path d="M21.036 12.569a.601.601 0 0 1-.439.186H4.601l4.57 4.551c.117.13.176.28.176.449a.652.652 0 0 1-.176.449.877.877 0 0 1-.215.127.596.596 0 0 1-.468 0 .877.877 0 0 1-.215-.127l-5.625-5.625a2.48 2.48 0 0 1-.068-.107c-.02-.032-.042-.068-.068-.107a.736.736 0 0 1 0-.468 2.48 2.48 0 0 0 .068-.107c.02-.032.042-.068.068-.107l5.625-5.625a.652.652 0 0 1 .449-.176c.169 0 .319.059.449.176.117.13.176.28.176.449a.652.652 0 0 1-.176.449l-4.57 4.551h15.996a.601.601 0 0 1 .439.186.601.601 0 0 1 .186.439.599.599 0 0 1-.186.437z"/>
                                </svg>
                            </i>ALIŞVERİŞE DEVAM ET
                        </a>
                        <a href="/Sepetim/Clear" class="btn btn--text ml-auto text-danger" onclick="return confirm('Sepetinizdeki tüm ürünleri silmek istediğinize emin misiniz?');">
                            <i class="mb-4 mr-4">
                                <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-theme-165" viewBox="0 0 24 24" style="width: 16px; height: 16px; fill: currentColor;">
                                    <path d="M4.741 21.654a.601.601 0 0 1-.186-.439v-15h-1.25a.598.598 0 0 1-.439-.186.597.597 0 0 1-.186-.439.6.6 0 0 1 .186-.439.604.604 0 0 1 .439-.186h5v-2.5a.6.6 0 0 1 .186-.439.598.598 0 0 1 .439-.186h6.25c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439v2.5h5c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186h-1.25v15a.6.6 0 0 1-.186.439.601.601 0 0 1-.439.186H5.18a.598.598 0 0 1-.439-.186zM18.305 6.215h-12.5V20.59h12.5V6.215zM9.37 9.525a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965a.6.6 0 0 1 .186-.439.594.594 0 0 1 .438-.186c.169 0 .316.062.44.185zm.185-4.56h5V3.09h-5v1.875zm2.94 4.56a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965a.6.6 0 0 1 .186-.439.594.594 0 0 1 .438-.186c.169 0 .316.062.44.185zm2.246 0a.604.604 0 0 1 .439-.186c.169 0 .315.063.439.186a.601.601 0 0 1 .186.439v6.875c0 .17-.062.316-.186.439a.601.601 0 0 1-.439.186.598.598 0 0 1-.439-.186.598.598 0 0 1-.186-.439V9.965c0-.169.062-.316.186-.44z"/>
                                </svg>
                            </i>SEPETİ TEMİZLE
                        </a>
                    </div>
                </div>

                <!-- Sepet Özeti Sidebar -->
                <div class="col-lg-4 col-xl-3 mt-25 mt-lg-0">
                    <aside class="cart__sidebar p-20 border rounded" style="background: #fafafa;">
                        <h3 class="h5 mb-20 font-weight-bold text-uppercase">SEPET TOPLAMI</h3>

                        <div class="border-bottom border--dashed pb-15 mb-15">
                            <div class="d-flex justify-content-between mb-10">
                                <span>Ürün Ara Toplam:</span>
                                <span class="font-weight-bold" id="cart-page-subtotal">@Model.TotalPrice.ToString("N2") ₺</span>
                            </div>
                            <div class="d-flex justify-content-between mb-10">
                                <span>Kargo Ücreti:</span>
                                <span class="text-success font-weight-bold">Ücretsiz</span>
                            </div>
                            @if (Model.DiscountRate.HasValue && Model.DiscountRate.Value > 0)
                            {
                                <div class="d-flex justify-content-between mb-10 text-success">
                                    <span>İndirim Oranı:</span>
                                    <span>%@Model.DiscountRate.Value</span>
                                </div>
                            }
                        </div>

                        <div class="pt-10 border-bottom border--dashed pb-15 mb-15">
                            <label class="mb-10 font-weight-bold" for="CartSpecialInstructions">Sipariş Notu</label>
                            <textarea name="note" id="CartSpecialInstructions" class="form-control" rows="3" placeholder="Siparişinizle ilgili iletmek istediğiniz özel bir not..."></textarea>
                        </div>

                        <div class="pt-10">
                            <div class="d-flex justify-content-between align-items-center mb-10">
                                <h5 class="mb-0 font-weight-bold">GENEL TOPLAM</h5>
                                <h3 class="mb-0 text-primary font-weight-bold" id="cart-page-total">@Model.TotalPrice.ToString("N2") ₺</h3>
                            </div>
                            <p class="small text-muted mb-20">KDV Dahildir. Kargo ve vergiler sipariş aşamasında detaylandırılır.</p>
                            <a href="/Checkout/Index" class="btn btn--full btn--secondary py-3 text-uppercase font-weight-bold" style="font-size: 14px; letter-spacing: 0.5px;">
                                SİPARİŞİ TAMAMLA
                            </a>
                        </div>
                    </aside>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    (function () {
        function formatMoney(amount) {
            return Number(amount || 0).toLocaleString('tr-TR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) + ' ₺';
        }

        function calculateCartTotals() {
            var grandTotal = 0;
            var rows = document.querySelectorAll('.js-cart-page-item-row');
            rows.forEach(function (row) {
                var unitPrice = parseFloat(row.getAttribute('data-unit-price')) || 0;
                var qtyInput = row.querySelector('.js-cart-page-qty');
                var qty = qtyInput ? (parseInt(qtyInput.value) || 0) : 0;
                var rowTotal = unitPrice * qty;
                grandTotal += rowTotal;

                var rowTotalEl = row.querySelector('.js-cart-page-row-total');
                if (rowTotalEl) {
                    rowTotalEl.textContent = formatMoney(rowTotal);
                }
            });

            var subtotalEl = document.getElementById('cart-page-subtotal');
            if (subtotalEl) subtotalEl.textContent = formatMoney(grandTotal);

            var totalEl = document.getElementById('cart-page-total');
            if (totalEl) totalEl.textContent = formatMoney(grandTotal);

            if (rows.length === 0) {
                window.location.reload();
            }
        }

        function updateItemQuantity(productId, quantity, rowEl) {
            if (!productId || quantity < 1) return;

            fetch('/Basket/UpdateQuantity', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId,
                    quantity: quantity
                })
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data && data.success) {
                    calculateCartTotals();
                    if (window.StoreBasket && typeof window.StoreBasket.refresh === 'function') {
                        window.StoreBasket.refresh();
                    }
                } else {
                    alert((data && data.message) ? data.message : 'Adet güncellenirken bir hata oluştu.');
                }
            })
            .catch(function (err) {
                console.error('UpdateQuantity hatası:', err);
            });
        }

        function removeItemFromBasket(productId, rowEl) {
            if (!productId) return;

            fetch('/Basket/RemoveItem', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId
                })
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data && data.success) {
                    if (rowEl) {
                        rowEl.style.transition = 'opacity 0.3s ease, height 0.3s ease';
                        rowEl.style.opacity = '0';
                        setTimeout(function () {
                            rowEl.remove();
                            calculateCartTotals();
                            if (window.StoreBasket && typeof window.StoreBasket.refresh === 'function') {
                                window.StoreBasket.refresh();
                            }
                        }, 300);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert((data && data.message) ? data.message : 'Ürün sepetten silinirken bir hata oluştu.');
                }
            })
            .catch(function (err) {
                console.error('RemoveItem hatası:', err);
            });
        }

        // Event Listeners
        document.addEventListener('click', function (e) {
            // Artır (+) Butonu
            var plusBtn = e.target.closest('.js-cart-page-plus');
            if (plusBtn) {
                var row = plusBtn.closest('.js-cart-page-item-row');
                var pid = plusBtn.getAttribute('data-product-id');
                var input = row ? row.querySelector('.js-cart-page-qty') : null;
                if (input && pid) {
                    var val = parseInt(input.value) || 1;
                    val++;
                    input.value = val;
                    updateItemQuantity(pid, val, row);
                }
                return;
            }

            // Azalt (-) Butonu
            var minusBtn = e.target.closest('.js-cart-page-minus');
            if (minusBtn) {
                var row = minusBtn.closest('.js-cart-page-item-row');
                var pid = minusBtn.getAttribute('data-product-id');
                var input = row ? row.querySelector('.js-cart-page-qty') : null;
                if (input && pid) {
                    var val = parseInt(input.value) || 1;
                    if (val > 1) {
                        val--;
                        input.value = val;
                        updateItemQuantity(pid, val, row);
                    }
                }
                return;
            }

            // Sil (Trash) Butonu
            var removeBtn = e.target.closest('.js-cart-page-remove');
            if (removeBtn) {
                e.preventDefault();
                var pid = removeBtn.getAttribute('data-product-id');
                var row = removeBtn.closest('.js-cart-page-item-row');
                if (pid) {
                    removeItemFromBasket(pid, row);
                }
            }
        });

        // Adet inputu el ile değiştirilirse
        document.addEventListener('change', function (e) {
            var qtyInput = e.target.closest('.js-cart-page-qty');
            if (qtyInput) {
                var row = qtyInput.closest('.js-cart-page-item-row');
                var pid = qtyInput.getAttribute('data-product-id');
                var val = parseInt(qtyInput.value) || 1;
                if (val < 1) val = 1;
                qtyInput.value = val;
                if (pid) {
                    updateItemQuantity(pid, val, row);
                }
            }
        });
    })();
</script>
}

