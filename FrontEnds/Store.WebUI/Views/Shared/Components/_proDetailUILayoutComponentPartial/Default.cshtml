                                                <form method="post" action="javascript:void(0);" accept-charset="UTF-8"
                                                      class="d-flex flex-column w-100 m-0 mt-20" enctype="multipart/form-data"
                                                      data-js-product-form="" onsubmit="return false;">
                                                    <input type="hidden" id="product-detail-id" value="@Model.Id" />
                                                    <input type="hidden" id="product-detail-name" value="@Model.Name" />
                                                    <input type="hidden" id="product-detail-price" value="@Model.RetailPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                                    <input type="hidden" id="product-detail-image" value="@Model.MainImageUrl" />
                                                    <input type="hidden" id="product-detail-isrental" value="false" />
                                                    <input type="hidden" name="form_type" value="product"/>
                                                    <input type="hidden" name="utf8" value="✓"/>
                                                    <input type="hidden" name="variant_id" value="@Model.Id"
                                                           data-js-product-variant-input>

                                                    <div class="product-page-info__quantity mb-15">
                                                        <label class="font-weight-bold">ADET</label>
                                                        <div class="row align-items-center">
                                                            <div class="col-12 col-sm-4 mb-10 mb-sm-0">
                                                                <div class="input-quantity input-quantity--type-01 d-flex js-product-quantity"
                                                                     data-js-quantity-connect="footbar">
                                                                    <div class="d-flex flex-center mr-10 border cursor-pointer"
                                                                         data-control="-" style="width: 40px; height: 40px; min-width: 40px;"><i>
                                                                        <svg aria-hidden="true" focusable="false"
                                                                             role="presentation" class="icon icon-theme-189"
                                                                             viewBox="0 0 24 24">
