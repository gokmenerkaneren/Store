@model Store.WebUI.Models.ProductDetailViewModel
@using System.Linq
<style>
    /* ==========================================================================
       Instagram 468x585 Image Container & 5-Thumbnail Layout
       ========================================================================== */
    .product-page-gallery {
        max-width: 580px !important;
    }
    .product-page-gallery .d-flex.align-items-start {
        flex-wrap: nowrap !important;
        align-items: flex-start !important;
    }

    /* 1 no: Main Image Container */
    .product-page-gallery__main {
        width: 468px !important;
        min-width: 468px !important;
        max-width: 468px !important;
        height: 585px !important;
        min-height: 585px !important;
        max-height: 585px !important;
        position: relative !important;
        overflow: hidden !important;
    }
    .product-page-gallery__main > .position-relative {
        width: 468px !important;
        height: 585px !important;
        position: relative !important;
    }
    .product-page-gallery__main .fotorama,
    .product-page-gallery__main .fotorama__wrap,
    .product-page-gallery__main .fotorama__stage {
        width: 468px !important;
        max-width: 468px !important;
        height: 585px !important;
        max-height: 585px !important;
        background-color: #ffffff !important;
    }
    .product-page-gallery__main .fotorama__stage__shaft,
    .product-page-gallery__main .fotorama__stage__frame {
        width: 468px !important;
        height: 585px !important;
        background-color: #ffffff !important;
    }
    .product-page-gallery__main .fotorama__img {
        top: 0 !important;
        left: 0 !important;
        width: 468px !important;
        height: 585px !important;
        max-width: 468px !important;
        max-height: 585px !important;
        object-fit: contain !important;
        object-position: center top !important;
        background-color: #ffffff !important;
    }

    /* 1 & 2 no: Zoom Container */
    .product-page-gallery .zoomContainer,
    .product-page-gallery [data-js-product-gallery-zoom] .zoomContainer {
        width: 468px !important;
        height: 585px !important;
        max-width: 468px !important;
        max-height: 585px !important;
        left: 0 !important;
        top: 0 !important;
        transform: none !important;
        position: absolute !important;
    }
    .product-page-gallery .zoomContainer .zoomWindowContainer,
    .product-page-gallery .zoomContainer .zoomWindow {
        width: 468px !important;
        height: 585px !important;
    }

    /* 3 no: Vertical 5-Thumbnails Preview */
    .product-page-gallery__preview {
        width: 86px !important;
        min-width: 86px !important;
        max-width: 86px !important;
        height: 585px !important;
        min-height: 585px !important;
        max-height: 585px !important;
        overflow: hidden !important;
        margin-right: 10px !important;
    }
    .product-page-gallery__preview [data-js-product-gallery-preview] {
        height: 585px !important;
    }
    .product-page-gallery__preview .slick-list {
        height: 585px !important;
        max-height: 585px !important;
    }
    .product-page-gallery__preview .slick-track {
        height: auto !important;
    }
    .product-page-gallery__preview [data-js-product-gallery-preview-image] {
        width: 86px !important;
        height: 107px !important;
        margin-bottom: 10px !important;
        outline: none !important;
        cursor: pointer;
    }
    .product-page-gallery__preview [data-js-product-gallery-preview-image] .rimage {
        width: 86px !important;
        height: 107px !important;
        padding-top: 0 !important;
        border-radius: 4px;
        overflow: hidden;
    }
    .product-page-gallery__preview [data-js-product-gallery-preview-image] .rimage__img {
        width: 86px !important;
        height: 107px !important;
        position: relative !important;
        object-fit: cover !important;
    }
    .product-page-gallery__preview [data-js-product-gallery-preview-image].current {
        border: 2px solid #141414 !important;
    }
    /* Sepette ve Favoride Olan Ürün Buton Stilleri */
    .btn.is-in-cart,
    button.js-product-button-add-to-cart.is-in-cart {
        background-color: #2b8a3e !important;
        border-color: #2b8a3e !important;
        color: #ffffff !important;
    }
    .btn.is-in-cart:hover,
    button.js-product-button-add-to-cart.is-in-cart:hover {
        background-color: #237032 !important;
        border-color: #237032 !important;
        color: #ffffff !important;
    }
    .btn.is-favorite,
    a.js-btn-favorite.is-favorite {
        border-color: #e03131 !important;
        color: #e03131 !important;
    }
</style>
    <div id="theme-section-product" class="theme-section">


        <div data-section-id="product" data-section-type="product-page" data-enable-history-state="true">
            <div class="product-page my-30">
                <div class="container">
                    <div class="product-page__container">
                        <!-- Burada alan başlıyor. -->
                        <div class="product-page__main">
                            <div class="product-page-main" data-js-product
                                 data-product-id="@Model.Id"
                                 data-product-handle="@Model.Slug"
                                 data-product-variant-id="@Model.Id"
                                 data-js-product-clone-id="footbar">
                                <div class="row">
                                    <!-- ========================================================================= -->
                                    <!-- #region SOL KOLON: GALERİ, ADET VE BUTONLAR (BAŞLANGIÇ)                   -->
                                    <!-- ========================================================================= -->
                                    <div class="col-12 col-lg-6" data-sticky-sidebar-parent>
                                        <div class="js-sticky-sidebar" data-top-spacing="10" data-disable-moz>
                                            <div data-sticky-sidebar-inner>

                                                <div class="product-page-gallery mx-auto pb-0" data-js-product-gallery
                                                     data-active-image="0">
                                                    <div class="d-flex align-items-start">
                                                        <!-- Dikey Slayder başlangıcı -->
                                                        <div class="product-page-gallery__preview position-relative d-none d-lg-block mr-10">
                                                            <div class="h-100 invisible"
                                                                 data-js-product-gallery-preview
                                                                 data-slides-to-show="@Math.Min(Model.ImageUrls != null && Model.ImageUrls.Count > 0 ? Model.ImageUrls.Count : 1, 5)">
                                                                 <!-- Burada resimler listeleniyor ( Dikey Slider adedi yukarıda belirlendi  -->
                                                                 
                                                                 @for(int i = 0; i < Model.ImageUrls.Count; i++)
                                                                 {
                                                                     var img = Model.ImageUrls[i];
                                                                     var currentClass = i == 0 ? "current" : "";
                                                                     <div class="mb-10 cursor-lg-pointer @currentClass"
                                                                          data-js-product-gallery-preview-image
                                                                          data-js-product-gallery-image-id="@i">
                                                                         <div class="rimage" style="width: 86px; height: 107px; padding-top: 0;">
                                                                             <img src="@img"
                                                                                  class="rimage__img rimage__img--fade-in lazyload"
                                                                                  data-master="@img"
                                                                                  data-aspect-ratio="0.8"
                                                                                  data-srcset="@img 1x, @img 2x"
                                                                                  alt="@Model.Name" style="width: 86px; height: 107px; object-fit: cover;">
                                                                         </div>
                                                                     </div>
                                                                 }
                                                            </div>
                                                            <div class="product-page-gallery__preview-arrows position-absolute bottom-0 w-100 d-flex flex-center">
                                                                <div class="d-flex cursor-lg-pointer"
                                                                     data-js-product-gallery-preview-btn-prev><i>
                                                                    <svg aria-hidden="true" focusable="false"
                                                                         role="presentation" class="icon icon-theme-229"
                                                                         viewBox="0 0 24 24">
                                                                        <path d="M11.783 14.088l-3.75-3.75a.652.652 0 0 1-.176-.449c0-.169.059-.319.176-.449a.65.65 0 0 1 .449-.176c.169 0 .318.059.449.176l3.301 3.32 3.301-3.32a.65.65 0 0 1 .449-.176c.169 0 .318.059.449.176.117.13.176.28.176.449a.652.652 0 0 1-.176.449l-3.75 3.75a.877.877 0 0 1-.215.127.596.596 0 0 1-.468 0 .841.841 0 0 1-.215-.127z"/>
                                                                    </svg>
                                                                </i></div>
                                                                <div class="d-flex cursor-lg-pointer"
                                                                     data-js-product-gallery-preview-btn-next><i>
                                                                    <svg aria-hidden="true" focusable="false"
                                                                         role="presentation" class="icon icon-theme-230"
                                                                         viewBox="0 0 24 24">
                                                                        <path d="M8.149 14.264a.65.65 0 0 1-.449-.176.652.652 0 0 1-.176-.449c0-.169.059-.319.176-.449l3.75-3.75a.65.65 0 0 1 .449-.176c.169 0 .318.059.449.176l3.75 3.75c.117.13.176.28.176.449a.652.652 0 0 1-.176.449.877.877 0 0 1-.215.127.596.596 0 0 1-.468 0 .877.877 0 0 1-.215-.127l-3.301-3.32-3.301 3.32a.654.654 0 0 1-.449.176z"/>
                                                                    </svg>
                                                                </i></div>
                                                            </div>
                                                        </div>
                                                        <!-- Resmin olduğu bölüm-->
                                                        <div class="product-page-gallery__main">
                                                            <div class="position-relative">
                                                                @{
                                                                    var indexIdStr = "[" + string.Join(",", Enumerable.Range(0, Model.ImageUrls.Count)) + "]";
                                                                    var zoomImagesStr = "[" + string.Join(",", Model.ImageUrls.Select(url => "\"" + url + "\"")) + "]";
                                                                }
                                                                <div class="invisible"
                                                                     data-js-product-gallery-main
                                                                     data-arrows="true"
                                                                     data-fullscreen="true"
                                                                     data-width="468"
                                                                     data-height="585"
                                                                     data-ratio="468/585"
                                                                     data-fit="contain"
                                                                     data-index-id='@indexIdStr'
                                                                     data-zoom-images='@zoomImagesStr'
                                                                     data-zoom="true">
                                                                     
                                                                     @foreach(var img in Model.ImageUrls)
                                                                     {
                                                                        <img src="@img"
                                                                             srcset="@img 1x, @img 2x"
                                                                             data-full="@img"
                                                                              alt="@Model.Name">
                                                                     }
                                                                </div>
                                                                <div class="absolute-stretch d-none d-lg-block"
                                                                     data-js-product-gallery-zoom></div>
                                                                <div class="product-page-gallery__main-arrow position-absolute d-flex flex-center left-0 ml-10 rounded-circle overflow-hidden cursor-pointer"
                                                                     data-js-product-gallery-main-btn-prev><i
                                                                        class="position-relative mr-1">
                                                                    <svg aria-hidden="true" focusable="false"
                                                                         role="presentation" class="icon icon-theme-006"
                                                                         viewBox="0 0 24 24">
                                                                        <path d="M16.736 3.417a.652.652 0 0 1-.176.449l-8.32 8.301 8.32 8.301c.117.13.176.28.176.449s-.059.319-.176.449a.91.91 0 0 1-.215.127c-.078.032-.156.049-.234.049s-.156-.017-.234-.049a.93.93 0 0 1-.215-.127l-8.75-8.75a.652.652 0 0 1-.176-.449c0-.169.059-.319.176-.449l8.75-8.75a.652.652 0 0 1 .449-.176c.169 0 .319.059.449.176.117.13.176.28.176.449z"/>
                                                                    </svg>
                                                                </i></div>
                                                                <div class="product-page-gallery__main-arrow position-absolute d-flex flex-center right-0 mr-10 rounded-circle overflow-hidden cursor-pointer"
                                                                     data-js-product-gallery-main-btn-next><i
                                                                        class="position-relative ml-4">
                                                                    <svg aria-hidden="true" focusable="false"
                                                                         role="presentation" class="icon icon-theme-007"
                                                                         viewBox="0 0 24 24">
                                                                        <path d="M6.708 20.917c0-.169.059-.319.176-.449l8.32-8.301-8.32-8.301a.652.652 0 0 1-.176-.449c0-.169.059-.319.176-.449a.65.65 0 0 1 .449-.176c.169 0 .318.059.449.176l8.75 8.75c.117.13.176.28.176.449a.652.652 0 0 1-.176.449l-8.75 8.75a.91.91 0 0 1-.215.127c-.078.032-.156.049-.234.049s-.156-.017-.234-.049a.91.91 0 0 1-.215-.127.652.652 0 0 1-.176-.449z"/>
                                                                    </svg>
                                                                </i></div>
                                                            </div>
                                                            <div class="product-page-gallery__control d-none d-lg-flex justify-content-end align-items-center mt-10">
                                                                <div class="d-flex align-items-center cursor-pointer mb-3"
                                                                     data-js-product-gallery-btn-fullscreen><i class="mr-3">
                                                                    <svg aria-hidden="true" focusable="false"
                                                                         role="presentation" class="icon icon-theme-166"
                                                                         viewBox="0 0 24 24">
