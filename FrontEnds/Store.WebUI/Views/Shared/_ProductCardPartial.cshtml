@model Store.WebUI.Models.ProductListViewModel
@{
    var hoverClass = !string.IsNullOrEmpty(Model.HoverImageUrl) ? "js-product-images-hover" : "";
    var hoverAttr  = !string.IsNullOrEmpty(Model.HoverImageUrl)
        ? $"data-js-product-image-hover=\"{Model.HoverImageUrl}#{{width}}\""
        : "";
}

@* Tek bir urun karti - her iki sekmede de kullanilir *@
<div class="carousel__item col-auto">
    <div class="product-collection d-flex flex-column mb-30" data-js-product
         data-js-product-json-preload
         data-product-handle="product-@Model.Id"
         data-product-variant-id="@Model.Id">

        <div class="product-collection__image product-image product-image--hover-emersion-z
                    position-relative w-100 js-product-images-navigation js-product-images-hovered-end @hoverClass"
             @Html.Raw(hoverAttr)
             data-js-product-image-hover-id="@Model.Id">

            <a href="/Product/Index/@Model.Id" class="d-block cursor-default" data-js-product-image>
                <div class="rimage" style="padding-top:100.0%;">
                    <img src="@Model.MainImageUrl"
                         data-src="@Model.MainImageUrl"
                         data-master="@Model.MainImageUrl#{{width}}"
                         class="rimage__img rimage__img--cover rimage__img--fade-in lazyload"
                         alt="@Model.Name"
                         data-aspect-ratio="1">
                </div>
            </a>

            @* Urun etiketleri ve hizli bakis butonu *@
            <div class="product-image__overlay-top position-absolute d-flex flex-wrap top-0 left-0 w-100 px-10 pt-10">
                <a href="/Product/Index/@Model.Id" class="absolute-stretch cursor-default"></a>
                <div class="product-image__overlay-top-left product-collection__labels
                            position-relative d-flex flex-column align-items-start mb-10">
                    <div class="label label--hot mb-3 mr-3 text-nowrap d-none-important" data-js-product-label-hot>Hot</div>
                    <div class="label label--new mb-3 mr-3 text-nowrap d-none-important" data-js-product-label-new>New</div>
                    <div class="label label--sale mb-3 mr-3 text-nowrap d-none-important" data-js-product-label-sale></div>
                    <div class="label label--out-stock mb-3 mr-3 text-nowrap d-none-important" data-js-product-label-out-stock>Out Stock</div>
                </div>
                <div class="product-image__overlay-top-right product-collection__button-quick-view
                            position-lg-relative d-none d-lg-flex flex-column mb-lg-10 ml-lg-auto">
                    

                    @* Favorilere Ekle Butonu *@
                    <a href="javascript:void(0);" 
                       class="button-wishlist d-flex flex-center rounded-circle js-btn-favorite mb-5"
                       data-product-id="@Model.Id"
                       data-js-tooltip
                       data-tippy-content="Favorilere Ekle"
                       data-tippy-theme="large"
                       data-tippy-placement="left"
                       data-tippy-distance="5">
                        <i class="icon-heart-empty">
                            <svg aria-hidden="true" focusable="false" role="presentation" class="icon custom-heart-icon" viewBox="0 0 24 24" width="16" height="16">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                        </i>
                    </a>

                    @* Hızlı Bakış Butonu *@
                    <a href="/Product/QuickView/@Model.Id"
   class="button-quick-view d-flex flex-center rounded-circle js-popup-button"
   data-js-popup-button="quick-view"
   data-js-tooltip
   data-tippy-content="<i style='color: #ffffff;'>Hızlı Bakış</i>"
   data-tippy-allowHTML="true"
   data-tippy-theme="large"
   data-tippy-placement="left"
   data-tippy-distance="5">
    <i>
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon" viewBox="0 0 576 512" style="width:16px; height:16px;">
            <path fill="currentColor" d="M288 144a110.94 110.94 0 0 0 -31.24 5 55.4 55.4 0 0 1 7.24 27 56 56 0 0 1 -56 56 55.4 55.4 0 0 1 -27 -7.24A111.71 111.71 0 1 0 288 144zm284.52 97.4C518.29 135.59 410.93 64 288 64S57.68 135.64 3.48 241.41a32.35 32.35 0 0 0 0 29.19C57.71 376.41 165.07 448 288 448s230.32-71.64 284.52-177.41a32.35 32.35 0 0 0 0-29.19zM288 400c-98.65 0-189.09-55-237.93-144C98.91 167 189.34 112 288 112s189.09 55 237.93 144C477.1 345 386.66 400 288 400z"/>
        </svg>
    </i>
</a>
                </div>
            </div>

            @* Geri sayim alani (gerekmediginde gizli) *@
            <div class="product-image__overlay-bottom position-absolute d-flex
                        justify-content-center justify-content-lg-start align-items-end
                        bottom-0 left-0 w-100 px-10 pb-10">
                <a href="/Product/Index/@Model.Id" class="absolute-stretch cursor-default"></a>
                <div class="product-image__overlay-bottom-left product-collection__countdown position-relative mt-10">
                    <div class="d-none-important" data-js-product-countdown>
                        <div class="countdown countdown--type-01 d-flex flex-wrap justify-content-center js-countdown"></div>
                    </div>
                </div>
            </div>
        </div>

        @* Urun adi, fiyat ve sepete ekle butonu *@
        <div class="product-collection__content d-flex flex-column align-items-start mt-15">
            <div class="product-collection__title mb-3">
                <h4 class="h6 m-0">
                    <a href="/Product/Index/@Model.Id">@Model.Name</a>
                </h4>
            </div>
            <div class="product-collection__price mb-10">
                <span class="price" data-js-product-price>
                    <span><span class="money">@Model.RetailPrice.ToString("C2")</span></span>
                    <span class="price__compare">
                        <span class="money"><del>@Model.OldPrice.ToString("C2")</del></span>
                    </span>
                </span>
            </div>
            <form method="post" action="/cart/add" accept-charset="UTF-8"
                  class="d-flex flex-column w-100 m-0" enctype="multipart/form-data"
                  data-js-product-form="" onsubmit="return false;">
                <input type="hidden" name="form_type" value="product" />
                <input type="hidden" name="utf8" value="&#x2713;" />
                <div class="product-collection__buttons d-flex flex-column flex-lg-row
                            align-items-lg-center flex-wrap mt-5 mt-lg-10">
                    <div class="product-collection__button-add-to-cart mb-10">
                        <button type="button"
                                class="btn btn--status btn--animated js-product-button-add-to-cart"
                                name="add" data-js-product-button-add-to-cart
                                data-product-id="@Model.Id"
                                data-product-name="@Model.Name"
                                data-product-price="@Model.RetailPrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                data-product-image="@Model.MainImageUrl"
                                data-product-isrental="false">
                            <span class="d-flex flex-center">
                                <i class="btn__icon mr-5 mb-4">
                                    <svg aria-hidden="true" focusable="false" role="presentation"
                                         class="icon icon-theme-109" viewBox="0 0 24 24">
                                        <path d="M19.884 21.897a.601.601 0 0 1-.439.186h-15a.6.6 0 0 1-.439-.186.601.601 0 0 1-.186-.439v-15a.6.6 0 0 1 .186-.439.601.601 0 0 1 .439-.186h3.75c0-1.028.368-1.911 1.104-2.646.735-.735 1.618-1.104 2.646-1.104s1.911.368 2.646 1.104c.735.736 1.104 1.618 1.104 2.646h3.75a.6.6 0 0 1 .439.186.601.601 0 0 1 .186.439v15a.604.604 0 0 1-.186.439z"/>
                                    </svg>
                                </i>
                                <span class="btn__text">SEPETE EKLE</span>
                            </span>
                            <span class="d-flex flex-center" data-button-content="added">EKLENDİ</span>
                            <span class="d-flex flex-center" data-button-content="sold-out">TÜKENDİ</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
