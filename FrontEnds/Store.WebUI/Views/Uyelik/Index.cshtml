    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Mask implementation for phone number
            $('.phone-mask').mask('(000) 000 00 00');

            // Form validation logic
            const loginEmailOrPhoneInput = document.getElementById('loginEmailOrPhone');
            const loginEmailOrPhoneError = document.getElementById('loginEmailOrPhoneError');

            const regFormInit = document.getElementById('registerForm');
            if(regFormInit) {
                regFormInit.reset();
            }

            const emailInput = document.getElementById('registerEmail');
            const emailError = document.getElementById('registerEmailError');
            const phoneInput = document.getElementById('registerPhone');
            const phoneError = document.getElementById('registerPhoneError');
            const passInput = document.getElementById('registerPassword');
            const confirmPassInput = document.getElementById('registerConfirmPassword');
            const passError = document.getElementById('registerPasswordError');
            const showPasswordsToggle = document.getElementById('showPasswordsToggle');

            // Email format (requires @@ and at least 2 chars after the dot)
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
            // Phone format (must match (555) 444 33 22 strictly)
            const phoneRegex = /^\(\d{3}\) \d{3} \d{2} \d{2}$/;
            // Password format (8-15 chars, at least 1 digit, 1 upper, 1 lower)
            const passRegex = /^(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,15}$/;

            function validateLoginEmailOrPhone() {
                const val = loginEmailOrPhoneInput.value.trim();
                // Eğer içinde @@ varsa veya harf varsa e-posta olarak değerlendirip format kontrolü yapıyoruz.
                // Sadece rakamlardan oluşuyorsa (telefon varsayımıyla) bu kuralı atlayabiliriz.
                if (val.includes('@@') || /[a-zA-Z]/.test(val)) {
                    if (!emailRegex.test(val)) {
                        loginEmailOrPhoneError.style.display = 'block';
                        loginEmailOrPhoneInput.style.borderColor = 'red';
                        return false;
                    } else {
                        loginEmailOrPhoneError.style.display = 'none';
                        loginEmailOrPhoneInput.style.borderColor = '#e1e1e1';
                        return true;
                    }
                }
                
                loginEmailOrPhoneError.style.display = 'none';
                loginEmailOrPhoneInput.style.borderColor = '#e1e1e1';
                return true;
            }

            function validateEmail() {
                if (!emailRegex.test(emailInput.value)) {
                    emailError.style.display = 'block';
                    emailInput.style.borderColor = 'red';
                    return false;
                } else {
                    emailError.style.display = 'none';
                    emailInput.style.borderColor = '#e1e1e1';
                    return true;
                }
            }

            function validatePhone() {
                if (!phoneRegex.test(phoneInput.value)) {
                    phoneError.style.display = 'block';
                    phoneInput.style.borderColor = 'red';
                    return false;
                } else {
                    phoneError.style.display = 'none';
                    phoneInput.style.borderColor = '#e1e1e1';
                    return true;
                }
            }

            function validatePasswords() {
                let isValid = true;
                if (!passRegex.test(passInput.value)) {
                    isValid = false;
                }
                if (passInput.value !== confirmPassInput.value) {
                    isValid = false;
                }
                if (!isValid && (passInput.value !== "" || confirmPassInput.value !== "")) {
                    passError.style.display = 'block';
                    passInput.style.borderColor = 'red';
                    confirmPassInput.style.borderColor = 'red';
                } else {
                    passError.style.display = 'none';
                    passInput.style.borderColor = '#e1e1e1';
                    confirmPassInput.style.borderColor = '#e1e1e1';
                }
                return isValid;
            }

            loginEmailOrPhoneInput.addEventListener('blur', validateLoginEmailOrPhone);
            emailInput.addEventListener('blur', validateEmail);
            phoneInput.addEventListener('blur', validatePhone);
            passInput.addEventListener('blur', validatePasswords);
            passInput.addEventListener('keyup', validatePasswords);
            confirmPassInput.addEventListener('blur', validatePasswords);
            confirmPassInput.addEventListener('keyup', validatePasswords);

            // Show Passwords functionality
            showPasswordsToggle.addEventListener('change', function() {
                if (this.checked) {
                    passInput.type = 'text';
                    confirmPassInput.type = 'text';
                } else {
                    passInput.type = 'password';
                    confirmPassInput.type = 'password';
                }
            });

            // Login Show Password functionality
            const showLoginPasswordToggle = document.getElementById('showLoginPasswordToggle');
            const loginPasswordInput = document.getElementById('loginPassword');
            if (showLoginPasswordToggle && loginPasswordInput) {
                showLoginPasswordToggle.addEventListener('change', function() {
                    if (this.checked) {
                        loginPasswordInput.type = 'text';
                    } else {
                        loginPasswordInput.type = 'password';
                    }
                });
            }

            // Prevent form submit if invalid
            const loginForm = document.getElementById('loginForm');
            let isPasswordStep = false;

            if (loginForm) {
                loginForm.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    if (!validateLoginEmailOrPhone()) {
                        return;
                    }

                    const messageContainer = document.getElementById('loginMessageContainer');
                    const passContainer = document.getElementById('loginPasswordContainer');
                    const loginBtn = document.getElementById('loginSubmitBtn');
                    const passInputLogin = document.getElementById('loginPassword');

                    messageContainer.style.display = 'none';

                    if (!isPasswordStep) {
                        // 1. Adım: Kullanıcı var mı kontrol et
                        const emailOrPhone = document.getElementById('loginEmailOrPhone').value;
                        
                        loginBtn.innerHTML = "Kontrol Ediliyor...";
                        loginBtn.disabled = true;

                        try {
                            const response = await fetch('/Uyelik/CheckUser', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ EmailOrPhone: emailOrPhone })
                            });

                            loginBtn.disabled = false;
                            loginBtn.innerHTML = "Giriş Yap";

                            if (response.ok) {
                                const result = await response.json();
                                if (result.exists) {
                                    // Kullanıcı bulundu, şifre alanını aç
                                    // Tarayıcının alakasız doldurmalarını önlemek için temizliyoruz
                                    passInputLogin.value = '';
                                    passContainer.style.display = 'block';
                                    passInputLogin.required = true;
                                    isPasswordStep = true;
                                    passInputLogin.focus();
                                } else {
                                    // Kullanıcı bulunamadı
                                    messageContainer.style.display = 'block';
                                    messageContainer.style.backgroundColor = '#f8d7da';
                                    messageContainer.style.color = '#721c24';
                                    messageContainer.style.border = '1px solid #f5c6cb';
                                    messageContainer.innerHTML = "Bu e-posta veya telefon ile kayıtlı bir hesap bulunamadı.";
                                }
                            } else {
                                throw new Error("API Error");
                            }
                        } catch (error) {
                            loginBtn.disabled = false;
                            loginBtn.innerHTML = "Devam Et";
                            messageContainer.style.display = 'block';
                            messageContainer.style.backgroundColor = '#f8d7da';
                            messageContainer.style.color = '#721c24';
                            messageContainer.style.border = '1px solid #f5c6cb';
                            messageContainer.innerHTML = "Bir hata oluştu. Lütfen daha sonra tekrar deneyiniz.";
                        }
                    } else {
                        // 2. Adım: Şifre girildi, giriş yap
                        if (passInputLogin.value.trim() === "") {
                            passInputLogin.style.borderColor = 'red';
                            return;
                        }
                        // Formu sunucuya normal gönder (veya login AJAX ile yapılabilir)
                        loginForm.submit();
                    }
                });
            }

            const registerForm = document.getElementById('registerForm');
            if (registerForm) {
                registerForm.addEventListener('submit', async function(e) {
                    e.preventDefault(); // Varsayılan post davranışını engelle
                    
                    const isEmailValid = validateEmail();
                    const isPhoneValid = validatePhone();
                    const isPassValid = validatePasswords();
                    if (!isEmailValid || !isPhoneValid || !isPassValid) {
                        return; // Validasyon hatası varsa API'ye gitme
                    }

                    const messageContainer = document.getElementById('registerMessageContainer');
                    messageContainer.style.display = 'none';

                    // Formdaki verileri JSON formatına çevir
                    const formData = new FormData(registerForm);
                    const data = Object.fromEntries(formData.entries());
                    // Checkbox'lar seçili değilse 'false' yap, seçiliyse 'true' yap
                    data.Terms = formData.has('Terms');
                    data.Marketing = formData.has('Marketing');

                    try {
                        const response = await fetch('/Uyelik/Register', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                            },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json().catch(() => ({}));
                        
                        messageContainer.style.display = 'block';
                        
                        if (response.ok) {
                            messageContainer.style.backgroundColor = '#d4edda';
                            messageContainer.style.color = '#155724';
                            messageContainer.style.border = '1px solid #c3e6cb';
                            messageContainer.innerHTML = result.message || "Kaydınız başarıyla tamamlandı. Lütfen giriş yapınız.";
                            registerForm.reset(); // Başarılıysa formu temizle
                            
                            // 3 saniye sonra Giriş Yap sekmesine geçir
                            setTimeout(() => {
                                document.querySelectorAll("[data-js-tabs-btn]")[0].click();
                                messageContainer.style.display = 'none';
                            }, 3000);
                        } else {
                            messageContainer.style.backgroundColor = '#f8d7da';
                            messageContainer.style.color = '#721c24';
                            messageContainer.style.border = '1px solid #f5c6cb';
                            // IdentityServer'dan dönen hata bazen bir obje bazen string olabilir, kontrol edelim.
                            if (result.message) {
                                messageContainer.innerHTML = result.message;
                            } else if (result.length && result[0].description) {
                                // IdentityResult.Errors listesi gelirse
                                messageContainer.innerHTML = result.map(x => x.description).join('<br>');
                            } else {
                                messageContainer.innerHTML = "Kayıt sırasında bir hata oluştu. Lütfen bilgilerinizi kontrol ediniz.";
                            }
                        }
                    } catch (error) {
                        messageContainer.style.display = 'block';
                        messageContainer.style.backgroundColor = '#f8d7da';
                        messageContainer.style.color = '#721c24';
                        messageContainer.style.border = '1px solid #f5c6cb';
                        messageContainer.innerHTML = "Sunucuya bağlanılamadı. Lütfen daha sonra tekrar deneyiniz.";
                    }
                });
            }

            // Cinsiyet (Gender) butonlarının seçilme efekti
            const genderLabels = document.querySelectorAll('input[name="Gender"]');
            genderLabels.forEach(function(radio) {
                radio.addEventListener('change', function() {
                    document.querySelectorAll('input[name="Gender"]').forEach(r => {
                        r.parentElement.style.borderColor = '#e1e1e1';
                        r.parentElement.style.fontWeight = 'normal';
                        r.parentElement.style.color = '#555';
                    });
                    if (this.checked) {
                        this.parentElement.style.borderColor = '#000';
                        this.parentElement.style.fontWeight = 'bold';
                        this.parentElement.style.color = '#000';
                    }
                });
            });

            // Tabs JS Logic
            var tabs = document.querySelectorAll("[data-js-tabs-btn]");
            var contents = document.querySelectorAll("[data-js-tabs-tab]");
            
            tabs.forEach(function(tab, index) {
                tab.addEventListener("click", function() {
                    // Tüm sekmeleri inaktif yap
                    tabs.forEach(function(t) { 
                        t.removeAttribute("data-active");
                        t.classList.remove("active"); 
                        t.style.borderBottom = "2px solid transparent";
                        t.style.color = "#888";
                    });
                    // Tıklanan sekmeyi aktif yap
                    this.setAttribute("data-active", "true");
                    this.classList.add("active");
                    this.style.borderBottom = "2px solid #000";
                    this.style.color = "#000";
                    
                    // Tüm içerikleri gizle
                    contents.forEach(function(c) { 
                        c.style.display = "none"; 
                        c.classList.remove("active");
                    });
                    // İlgili içeriği göster
                    if(contents[index]) {
                        contents[index].style.display = "block";
                        contents[index].classList.add("active");
                    }
                });
            });
        });
    </script>
</body>
</html>
