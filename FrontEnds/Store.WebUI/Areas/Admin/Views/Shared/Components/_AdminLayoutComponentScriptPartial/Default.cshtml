<!-- notification js -->
<script type="text/javascript" src="~/ZZDenge/files/assets/js/bootstrap-growl.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function showToastAlert(message, type, title, animIn, animOut) {
        type = type || 'danger';
        animIn = animIn || 'animated fadeInLeft';
        animOut = animOut || 'animated fadeOutLeft';

        var bgClass = '';
        if (type === 'danger') bgClass = 'background-danger';
        else if (type === 'warning') bgClass = 'background-warning';
        else if (type === 'success') bgClass = 'background-success';
        else if (type === 'info') bgClass = 'background-info';
        else if (type === 'inverse') bgClass = 'alert-inverse';

        if (typeof $.growl === 'function') {
            $.growl({
                icon: '',
                title: title ? title : '',
                message: message,
                url: ''
            }, {
                element: 'body',
                type: type,
                allow_dismiss: true,
                placement: {
                    from: 'top',
                    align: 'right'
                },
                offset: {
                    x: 30,
                    y: 70
                },
                spacing: 10,
                z_index: 999999,
                delay: 5000,
                timer: 1000,
                url_target: '_blank',
                mouse_over: false,
                animate: {
                    enter: animIn,
                    exit: animOut
                },
                icon_type: 'class',
                template: '<div data-growl="container" class="alert alert-' + type + ' ' + bgClass + ' waves-effect waves-light" role="alert" style="box-shadow: 0 4px 14px rgba(0,0,0,0.3); border-radius: 4px; padding: 18px 20px; color: #fff; width: 460px; max-width: 90vw;">' +
                    '<button type="button" class="close" data-growl="dismiss" style="opacity: 0.9; color: #fff; text-shadow: none; position: absolute; top: 12px; right: 14px; background: transparent; border: none; font-size: 22px; cursor: pointer;">' +
                    '<span aria-hidden="true">&times;</span>' +
                    '<span class="sr-only">Close</span>' +
                    '</button>' +
                    '<span data-growl="icon"></span>' +
                    '<span data-growl="title" style="font-weight: bold; font-size: 17.5px;"></span>' +
                    '<span data-growl="message" style="font-size: 16.5px; line-height: 1.6; color: #fff; padding-right: 25px; font-weight: 500;"></span>' +
                    '<a href="#" data-growl="url"></a>' +
                    '</div>'
            });
        } else {
            var container = $('#toast-container');
            if (container.length === 0) {
                $('body').append('<div id="toast-container" style="position: fixed; top: 70px; right: 20px; z-index: 999999; width: 460px; max-width: 90vw;"></div>');
                container = $('#toast-container');
            }
            var alertId = 'toast-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
            var alertHtml = `
                <div id="${alertId}" class="alert alert-${type} ${bgClass} ${animIn} waves-effect waves-light" style="margin-bottom: 10px; box-shadow: 0 4px 14px rgba(0,0,0,0.3); border-radius: 4px; padding: 18px 20px; color: #fff; position: relative;">
                    <button type="button" class="close" onclick="$('#${alertId}').addClass('${animOut}').fadeOut(300, function(){ $(this).remove(); });" aria-label="Close" style="opacity: 0.9; color: #fff; text-shadow: none; position: absolute; top: 12px; right: 14px; background: transparent; border: none; font-size: 22px; cursor: pointer;">
                        <i class="icofont icofont-close-line-circled text-white" style="font-size: 22px;"></i>
                    </button>
                    <div style="font-size: 16.5px; line-height: 1.6; color: #fff; padding-right: 25px; font-weight: 500;">
                        ${title ? `<strong style="font-size: 17.5px;">${title}</strong> ` : ''}${message}
                    </div>
                </div>
            `;
            var $alert = $(alertHtml);
            container.append($alert);
            setTimeout(function() {
                $alert.addClass(animOut).fadeOut(500, function() {
                    $(this).remove();
                });
            }, 5000);
        }
    }

    // Global Form Doğrulama Fonksiyonu (Tüm Admin Modalları ve Formları İçin)
    function validateForm(formElement) {
        var $form = $(formElement);
        var isValid = true;

        $form.find('input, select, textarea').each(function() {
            var $input = $(this);
            
            // Gizli veya disabled alanları atla
            if ($input.is(':hidden') && $input.attr('type') !== 'hidden') return;
            if ($input.prop('disabled')) return;

            var val = $input.val() ? $input.val().trim() : '';
            var isRequired = $input.prop('required') || $input.attr('required') !== undefined;
            var maxLength = $input.attr('maxlength');
            var minLength = $input.attr('minlength');

            // Etiket adını (label metnini veya placeholder) bul
            var fieldName = $input.closest('.form-group').find('label').text().trim() 
                || $input.attr('placeholder') 
                || 'İlgili';
            fieldName = fieldName.replace(/\*$/g, '').trim();

            // 1. Zorunlu Alan Kontrolü
            if (isRequired && val === '') {
                showToastAlert('Lütfen "' + fieldName + '" alanını doldurunuz.', 'danger', '', 'animated flipInY', 'animated flipOutY');
                $input.focus();
                isValid = false;
                return false; // döngüyü kır
            }

            // 2. Maksimum Karakter Kontrolü
            if (maxLength && val.length > parseInt(maxLength)) {
                showToastAlert('"' + fieldName + '" alanı en fazla ' + maxLength + ' karakter olabilir.', 'danger', '', 'animated flipInY', 'animated flipOutY');
                $input.focus();
                isValid = false;
                return false; // döngüyü kır
            }

            // 3. Minimum Karakter Kontrolü
            if (minLength && val.length < parseInt(minLength)) {
                showToastAlert('"' + fieldName + '" alanı en az ' + minLength + ' karakter olmalıdır.', 'danger', '', 'animated flipInY', 'animated flipOutY');
                $input.focus();
                isValid = false;
                return false; // döngüyü kır
            }
        });

        return isValid;
    }

    $(document).ready(function() {
        $(document).on('click', '.btn-delete-confirm', function(e) {
            e.preventDefault();
            var url = $(this).attr('href') || $(this).data('url');
            if (url && url !== 'javascript:void(0);') {
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            }
        });

        $(document).on('click', '.btn-restore-confirm', function(e) {
            e.preventDefault();
            var url = $(this).attr('href') || $(this).data('url');
            if (url && url !== 'javascript:void(0);') {
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu kaydı geri almak istediğinize emin misiniz?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Geri Al!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            }
        });
    });
</script>