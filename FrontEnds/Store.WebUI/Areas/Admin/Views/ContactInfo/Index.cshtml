@model List<Store.DtoLayer.LocationDtos.ContactInfoDtos.ResultContactInfoDto>
@{
    ViewData["Title"] = "ContactInfo Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        İLETİŞİM BİLGİLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Kurumsal İletişim & Yetkili Kişi Listesi</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />

    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="basic-btn" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Firma E-Posta</th>
                        <th>Telefon</th>
                        <th>Yetkili Kişi</th>
                        <th>Yetkili Tel</th>
                        <th>Aktif mi?</th>
                        <th>Notlar</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelleme Tarihi</th> 
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr style="@(item.IsDeleted ? "background-color:#c0392b; color:#fff; border-left:4px solid #922b21; font-weight:600;" : (!item.IsActive ? "opacity:0.5;background-color:#f8d7da;" : ""))">
                                <td>@item.CompanyEmail</td>
                                <td>@item.Phone</td>
                                <td>@item.AuthorizedPersonName</td>
                                <td>@item.AuthorizedPersonPhone</td>
                                <td><span class="label label-@(item.IsActive ? "success" : "danger")">@(item.IsActive ? "Evet" : "Hayır")</span></td>
                                <td>@item.Notes</td>
                                <td>@item.InsertDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>@(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm:ss"))</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-grd-info waves-effect waves-light" style="float: none;margin: 5px;"
                                                data-toggle="modal" data-target="#editModal"
                                                data-id="@item.Id" data-companyemail="@item.CompanyEmail" data-phone="@item.Phone" data-fax="@item.Fax" data-website="@item.Website" data-authorizedpersonname="@item.AuthorizedPersonName" data-authorizedpersontitle="@item.AuthorizedPersonTitle" data-authorizedpersonphone="@item.AuthorizedPersonPhone" data-authorizedpersonemail="@item.AuthorizedPersonEmail" data-isactive="@item.IsActive" data-notes="@item.Notes">
                                            <span class="feather icon-edit"></span>
                                        </button>
                                        <button type="button" class="btn btn-grd-success waves-effect waves-light" style="float: none;margin: 5px;"
                                                data-toggle="modal" data-target="#detailsModal"
                                                data-id="@item.Id" data-companyemail="@item.CompanyEmail" data-phone="@item.Phone" data-fax="@item.Fax" data-website="@item.Website" data-authorizedpersonname="@item.AuthorizedPersonName" data-authorizedpersontitle="@item.AuthorizedPersonTitle" data-authorizedpersonphone="@item.AuthorizedPersonPhone" data-authorizedpersonemail="@item.AuthorizedPersonEmail" data-isactive="@item.IsActive" data-notes="@item.Notes">
                                            <i class="icofont icofont-file-document"></i>
                                        </button>
                                        <a href="/Admin/ContactInfo/DeleteContactInfo/@item.Id" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="float: none;margin: 5px;">
                                            <span class="feather icon-trash"></span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn-grd-primary waves-effect waves-light" data-toggle="modal" data-target="#createModal">
                Yeni İletişim Bilgisi Ekle
            </button>
            <a href="/Admin/ContactInfo/Index?showDeleted=@(ViewBag.ShowDeleted != null && ViewBag.ShowDeleted ? "false" : "true")" class="btn btn-grd-warning waves-effect waves-light">
                @(ViewBag.ShowDeleted != null && ViewBag.ShowDeleted ? "Aktif Kayıtları Göster" : "Silinmiş Kayıtları Göster")
            </a>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="createForm">
                <div class="modal-header bg-c-blue text-white" style="background-color: #00bcd4 !important;">
                    <h5 class="modal-title text-white">Yeni İletişim Bilgisi Ekle</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Kurumsal E-Posta</label>
                            <input type="email" class="form-control" name="CompanyEmail" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Santral / Şirket Telefonu</label>
                            <input type="text" class="form-control" name="Phone" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Fax</label>
                            <input type="text" class="form-control" name="Fax" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Web Sitesi</label>
                            <input type="text" class="form-control" name="Website" />
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Yetkili Ad Soyad</label>
                            <input type="text" class="form-control" name="AuthorizedPersonName" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Yetkili Unvanı</label>
                            <input type="text" class="form-control" name="AuthorizedPersonTitle" placeholder="Örn: Satın Alma Müdürü" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Yetkili Telefonu</label>
                            <input type="text" class="form-control" name="AuthorizedPersonPhone" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Yetkili E-Posta</label>
                            <input type="email" class="form-control" name="AuthorizedPersonEmail" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Aktiflik Durumu</label>
                        <select class="form-control" name="IsActive">
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Notlar</label>
                        <textarea class="form-control" name="Notes" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-inverse" data-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" onclick="submitCreate()">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editForm">
                <input type="hidden" name="Id" id="edit-id" />
                <div class="modal-header bg-c-blue text-white" style="background-color: #00bcd4 !important;">
                    <h5 class="modal-title text-white">İletişim Bilgisini Güncelle</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Kurumsal E-Posta</label>
                            <input type="email" class="form-control" name="CompanyEmail" id="edit-companyemail" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Şirket Telefonu</label>
                            <input type="text" class="form-control" name="Phone" id="edit-phone" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Fax</label>
                            <input type="text" class="form-control" name="Fax" id="edit-fax" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Web Sitesi</label>
                            <input type="text" class="form-control" name="Website" id="edit-website" />
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Yetkili Ad Soyad</label>
                            <input type="text" class="form-control" name="AuthorizedPersonName" id="edit-authorizedpersonname" required />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Yetkili Unvanı</label>
                            <input type="text" class="form-control" name="AuthorizedPersonTitle" id="edit-authorizedpersontitle" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Yetkili Telefonu</label>
                            <input type="text" class="form-control" name="AuthorizedPersonPhone" id="edit-authorizedpersonphone" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Yetkili E-Posta</label>
                            <input type="email" class="form-control" name="AuthorizedPersonEmail" id="edit-authorizedpersonemail" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Aktiflik Durumu</label>
                        <select class="form-control" name="IsActive" id="edit-isactive">
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Notlar</label>
                        <textarea class="form-control" name="Notes" id="edit-notes" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-inverse" data-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-info" onclick="submitEdit()">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #00bcd4; border-radius: 5px 5px 0 0;">
                <h5 class="modal-title"><i class="feather icon-info"></i> İletişim Kaydı Detayları</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-sm-6"><strong>Id:</strong> <p id="det-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Kurumsal E-Posta:</strong> <p id="det-companyemail" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Telefon:</strong> <p id="det-phone" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Fax:</strong> <p id="det-fax" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Web Sitesi:</strong> <p id="det-website" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Yetkili Adı:</strong> <p id="det-authorizedpersonname" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Yetkili Unvanı:</strong> <p id="det-authorizedpersontitle" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Yetkili Telefonu:</strong> <p id="det-authorizedpersonphone" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Yetkili E-Posta:</strong> <p id="det-authorizedpersonemail" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Aktif mi?:</strong> <p id="det-isactive" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Notlar:</strong> <p id="det-notes" class="text-muted" style="white-space: pre-line;"></p></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-inverse" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $('#editModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var modal = $(this);
        modal.find('#edit-id').val(button.data('id'));
        modal.find('#edit-companyemail').val(button.data('companyemail'));
        modal.find('#edit-phone').val(button.data('phone'));
        modal.find('#edit-fax').val(button.data('fax'));
        modal.find('#edit-website').val(button.data('website'));
        modal.find('#edit-authorizedpersonname').val(button.data('authorizedpersonname'));
        modal.find('#edit-authorizedpersontitle').val(button.data('authorizedpersontitle'));
        modal.find('#edit-authorizedpersonphone').val(button.data('authorizedpersonphone'));
        modal.find('#edit-authorizedpersonemail').val(button.data('authorizedpersonemail'));
        modal.find('#edit-isactive').val(button.data('isactive').toString());
        modal.find('#edit-notes').val(button.data('notes'));
    });

    $('#detailsModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var modal = $(this);
        modal.find('#det-id').text(button.data('id'));
        modal.find('#det-companyemail').text(button.data('companyemail'));
        modal.find('#det-phone').text(button.data('phone'));
        modal.find('#det-fax').text(button.data('fax'));
        modal.find('#det-website').text(button.data('website'));
        modal.find('#det-authorizedpersonname').text(button.data('authorizedpersonname'));
        modal.find('#det-authorizedpersontitle').text(button.data('authorizedpersontitle'));
        modal.find('#det-authorizedpersonphone').text(button.data('authorizedpersonphone'));
        modal.find('#det-authorizedpersonemail').text(button.data('authorizedpersonemail'));
        modal.find('#det-isactive').text(button.data('isactive') ? 'Evet' : 'Hayır');
        modal.find('#det-notes').text(button.data('notes'));
    });

    function submitCreate() {
        var data = {};
        $('#createForm').serializeArray().map(function(x){data[x.name] = x.value;});
        $.post('/Admin/ContactInfo/Create', data, function (res) {
            if (res.success) location.reload();
            else alert('Hata: ' + res.message);
        });
    }

    function submitEdit() {
        var data = {};
        $('#editForm').serializeArray().map(function(x){data[x.name] = x.value;});
        $.post('/Admin/ContactInfo/Edit', data, function (res) {
            if (res.success) location.reload();
            else alert('Hata: ' + res.message);
        });
    }
</script>
