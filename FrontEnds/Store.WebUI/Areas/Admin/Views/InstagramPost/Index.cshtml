@model List<Store.DtoLayer.CatalogDtos.InstagramPostDtos.ResultInstagramPostDto>
@{
    ViewData["Title"] = "Instagram Gönderileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Instagram Akışı Yönetimi</h4>
                        <p class="card-title-desc">Ana sayfada sergilenecek Instagram gönderilerini (resim ve linklerini) buradan ekleyebilir ve kaldırabilirsiniz.</p>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Sıra</th>
                                        <th>Resim</th>
                                        <th>Instagram Linki</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.OrderIndex</td>
                                            <td>
                                                <img src="@item.ImageUrl" style="height: 50px; width: 50px; object-fit: cover;" class="rounded" />
                                            </td>
                                            <td><a href="@item.PostUrl" target="_blank">Gönderiye Git</a></td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Pasif</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="/Admin/InstagramPost/UpdateInstagramPost/@item.Id" class="btn btn-warning btn-sm"><i class="fa fa-pen"></i> Güncelle</a>
                                                <a href="/Admin/InstagramPost/DeleteInstagramPost/@item.Id" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Sil</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-4">
                            <a href="/Admin/InstagramPost/CreateInstagramPost/" class="btn btn-primary"><i class="fa fa-plus"></i> Yeni Gönderi Ekle</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
