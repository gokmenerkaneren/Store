                        <div class="form-group">
                            <label>InvoiceType</label>
                            <input type="text" class="form-control" name="InvoiceType" id="edit-invoiceType" required />
                        </div>
                        <div class="form-group">
                            <label>IdentityNumber</label>
                            <input type="text" class="form-control" name="IdentityNumber" id="edit-identityNumber" required />
                        </div>
                        <div class="form-group">
                            <label>TaxOffice</label>
