
@model List<Store.DtoLayer.LocationDtos.UserAddressDtos.ResultUserAddressDto>
@{
    ViewData["Title"] = "UserAddress Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        KULLANICI ADRESİ İŞLEMLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Firma Listesi</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />


    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="basic-btn" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>ContactFullName</th>
                        <th>PhoneNumber</th>
                        <th>AddressDetail</th>
                        <th>CityId</th>
                        <th>DistrictId</th>
                        <th>NeighborhoodId</th>
                        <th>CustomerId</th>
                        <th>InvoiceType</th>
                        <th>IdentityNumber</th>
                        <th>TaxOffice</th>
                        <th>TaxNumber</th>
                        <th>CompanyId</th>
                        <th>IsAnonymized</th>
                        <th>IsActive</th>
                        <th>Notes</th>
                        <th>InsertDate</th>
                        <th>UpdateDate</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr style="@(item.IsDeleted ? "background-color:#c0392b; color:#fff; border-left:4px solid #922b21; font-weight:600;" : (!item.IsActive ? "opacity:0.5;background-color:#f8d7da;" : ""))">
                                <td>@item.Title</td>
                                <td>@item.ContactFullName</td>
                                <td>@item.PhoneNumber</td>
                                <td>@item.AddressDetail</td>
                                <td>@item.CityId</td>
                                <td>@item.DistrictId</td>
                                <td>@item.NeighborhoodId</td>
                                <td>@item.CustomerId</td>
                                <td>@item.InvoiceType</td>
                                <td>@item.IdentityNumber</td>
                                <td>@item.TaxOffice</td>
                                <td>@item.TaxNumber</td>
                                <td>@item.CompanyId</td>
                                <td><span class="label label-@(item.IsAnonymized ? "success" : "danger")">@(item.IsAnonymized ? "Evet" : "Hayır")</span></td>
                                <td><span class="label label-@(item.IsActive ? "success" : "danger")">@(item.IsActive ? "Evet" : "Hayır")</span></td>
                                <td>@item.Notes</td>
                                <td>@item.InsertDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>@(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm:ss"))</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-grd-info waves-effect waves-light" style="float: none;margin: 5px;"
                                                data-toggle="modal" data-target="#editModal"
                                                 data-id="@item.Id" data-title="@item.Title" data-contactFullName="@item.ContactFullName" data-phoneNumber="@item.PhoneNumber" data-addressDetail="@item.AddressDetail" data-cityId="@item.CityId" data-districtId="@item.DistrictId" data-neighborhoodId="@item.NeighborhoodId" data-customerId="@item.CustomerId" data-invoiceType="@item.InvoiceType" data-identityNumber="@item.IdentityNumber" data-taxOffice="@item.TaxOffice" data-taxNumber="@item.TaxNumber" data-companyId="@item.CompanyId" data-isAnonymized="@item.IsAnonymized" data-isActive="@item.IsActive" data-notes="@item.Notes" data-insertUserId="@item.InsertUserId" data-insertDate="@(item.InsertDate.ToString("dd.MM.yyyy HH:mm:ss"))" data-updateUserId="@item.UpdateUserId" data-updateDate="@(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm:ss"))" data-isDeleted="@item.IsDeleted" data-deleteUserId="@item.DeleteUserId" data-deleteDate="@(item.DeleteDate?.ToString("dd.MM.yyyy HH:mm:ss"))">
                                            <span class="feather icon-edit"></span>
                                        </button>
                                        <button type="button" class="btn btn-grd-success waves-effect waves-light" style="float: none;margin: 5px;"
                                                data-toggle="modal" data-target="#detailsModal"
                                                 data-id="@item.Id" data-title="@item.Title" data-contactFullName="@item.ContactFullName" data-phoneNumber="@item.PhoneNumber" data-addressDetail="@item.AddressDetail" data-cityId="@item.CityId" data-districtId="@item.DistrictId" data-neighborhoodId="@item.NeighborhoodId" data-customerId="@item.CustomerId" data-invoiceType="@item.InvoiceType" data-identityNumber="@item.IdentityNumber" data-taxOffice="@item.TaxOffice" data-taxNumber="@item.TaxNumber" data-companyId="@item.CompanyId" data-isAnonymized="@item.IsAnonymized" data-isActive="@item.IsActive" data-notes="@item.Notes" data-insertUserId="@item.InsertUserId" data-insertDate="@(item.InsertDate.ToString("dd.MM.yyyy HH:mm:ss"))" data-updateUserId="@item.UpdateUserId" data-updateDate="@(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm:ss"))" data-isDeleted="@item.IsDeleted" data-deleteUserId="@item.DeleteUserId" data-deleteDate="@(item.DeleteDate?.ToString("dd.MM.yyyy HH:mm:ss"))">
                                            <i class="icofont icofont-file-document"></i>
                                        </button>
                                        <a href="/Admin/UserAddress/DeleteUserAddress/@item.Id" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="float: none;margin: 5px;">
                                            <span class="feather icon-trash"></span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn-grd-primary waves-effect waves-light" data-toggle="modal" data-target="#createModal">
                Yeni UserAddress Ekle
            </button>
            <a href="/Admin/UserAddress/Index?showDeleted=@(ViewBag.ShowDeleted != null && ViewBag.ShowDeleted ? "false" : "true")" class="btn btn-grd-warning waves-effect waves-light">
                @(ViewBag.ShowDeleted != null && ViewBag.ShowDeleted ? "Aktif Kayıtları Göster" : "Silinmiş Kayıtları Göster")
            </a>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createForm">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni UserAddress Ekle</h5>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" class="form-control" name="Title" required />
                        </div>
                        <div class="form-group">
                            <label>ContactFullName</label>
                            <input type="text" class="form-control" name="ContactFullName" required />
                        </div>
                        <div class="form-group">
                            <label>PhoneNumber</label>
                            <input type="text" class="form-control" name="PhoneNumber" required />
                        </div>
                        <div class="form-group">
                            <label>AddressDetail</label>
                            <input type="text" class="form-control" name="AddressDetail" required />
                        </div>
                        <div class="form-group">
                            <label>CityId</label>
                            <input type="text" class="form-control" name="CityId" required />
                        </div>
                        <div class="form-group">
                            <label>DistrictId</label>
                            <input type="text" class="form-control" name="DistrictId" required />
                        </div>
                        <div class="form-group">
                            <label>NeighborhoodId</label>
                            <input type="text" class="form-control" name="NeighborhoodId" required />
                        </div>
                        <div class="form-group">
                            <label>CustomerId</label>
                            <input type="text" class="form-control" name="CustomerId" required />
                        </div>
                        <div class="form-group">
                            <label>InvoiceType</label>
                            <input type="text" class="form-control" name="InvoiceType" required />
                        </div>
                        <div class="form-group">
                            <label>IdentityNumber</label>
                            <input type="text" class="form-control" name="IdentityNumber" required />
                        </div>
                        <div class="form-group">
                            <label>TaxOffice</label>
                            <input type="text" class="form-control" name="TaxOffice" required />
                        </div>
                        <div class="form-group">
                            <label>TaxNumber</label>
                            <input type="text" class="form-control" name="TaxNumber" required />
                        </div>
                        <div class="form-group">
                            <label>CompanyId</label>
                            <input type="text" class="form-control" name="CompanyId" required />
                        </div>
                        <div class="form-group">
                            <label>IsAnonymized</label>
                            <select class="form-control" name="IsAnonymized">
                                <option value="true">Evet</option>
                                <option value="false">Hayır</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>IsActive</label>
                            <select class="form-control" name="IsActive">
                                <option value="true">Evet</option>
                                <option value="false">Hayır</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Notes</label>
                            <input type="text" class="form-control" name="Notes" required />
                        </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-inverse" data-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" onclick="submitCreate()">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

