        modal.find('#det-contactFullName').text(button.data('contactFullName'));
        modal.find('#edit-phoneNumber').val(button.data('phoneNumber'));
        modal.find('#det-phoneNumber').text(button.data('phoneNumber'));
        modal.find('#edit-addressDetail').val(button.data('addressDetail'));
        modal.find('#det-addressDetail').text(button.data('addressDetail'));
        modal.find('#edit-cityId').val(button.data('cityId'));
        modal.find('#det-cityId').text(button.data('cityId'));
        modal.find('#edit-districtId').val(button.data('districtId'));
        modal.find('#det-districtId').text(button.data('districtId'));
        modal.find('#edit-neighborhoodId').val(button.data('neighborhoodId'));
        modal.find('#det-neighborhoodId').text(button.data('neighborhoodId'));
        modal.find('#edit-customerId').val(button.data('customerId'));
        modal.find('#det-customerId').text(button.data('customerId'));
        modal.find('#edit-invoiceType').val(button.data('ınvoiceType'));
        modal.find('#det-invoiceType').text(button.data('ınvoiceType'));
        modal.find('#edit-identityNumber').val(button.data('ıdentityNumber'));
        modal.find('#det-identityNumber').text(button.data('ıdentityNumber'));
        modal.find('#edit-taxOffice').val(button.data('taxOffice'));
        modal.find('#det-taxOffice').text(button.data('taxOffice'));
        modal.find('#edit-taxNumber').val(button.data('taxNumber'));
        modal.find('#det-taxNumber').text(button.data('taxNumber'));
        modal.find('#edit-companyId').val(button.data('companyId'));
        modal.find('#det-companyId').text(button.data('companyId'));
        var ısAnonymized = button.data('ısAnonymized') === 'True' || button.data('ısAnonymized') === true || button.data('ısAnonymized') === 'true';
        modal.find('#edit-isAnonymized').val(ısAnonymized.toString());
        modal.find('#det-isAnonymized').text(ısAnonymized ? 'Evet' : 'Hayır');
        var ısActive = button.data('ısActive') === 'True' || button.data('ısActive') === true || button.data('ısActive') === 'true';
        modal.find('#edit-isActive').val(ısActive.toString());
