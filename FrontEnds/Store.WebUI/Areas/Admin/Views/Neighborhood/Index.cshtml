@model List<Store.DtoLayer.LocationDtos.NeighborhoodDtos.ResultNeighborhoodDto>
@using Microsoft.AspNetCore.Mvc.Rendering
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Mahalle Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var countries = ViewBag.Countries as List<Store.DtoLayer.LocationDtos.CountryDtos.ResultCountryDto> ?? new List<Store.DtoLayer.LocationDtos.CountryDtos.ResultCountryDto>();
    var cities = ViewBag.Cities as List<Store.DtoLayer.LocationDtos.CityDtos.ResultCityDto> ?? new List<Store.DtoLayer.LocationDtos.CityDtos.ResultCityDto>();
    var districts = ViewBag.Districts as List<Store.DtoLayer.LocationDtos.DistrictDtos.ResultDistrictDto> ?? new List<Store.DtoLayer.LocationDtos.DistrictDtos.ResultDistrictDto>();
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        MAHALLE İŞLEMLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Mahalle Listesi ve İşlemleri</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />


    <div class="card-block">
        <div class="row m-b-20">
            <div class="col-md-4">
                <label><strong>Şehir Filtresi</strong></label>
                <select id="filter-city" class="form-control">
                    <option value="">-- Tüm Şehirler --</option>
                    @foreach (var city in cities)
                    {
                        <option value="@city.Id">@city.CityName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label><strong>İlçe Filtresi</strong></label>
                <select id="filter-district" class="form-control">
                    <option value="">-- Önce Şehir Seçiniz --</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end" style="padding-top:25px;">
                <button type="button" class="tabledit-edit-button btn btn-grd-primary waves-effect waves-light"
                        data-toggle="modal" data-target="#createNeighborhoodModal">
                    <i class="feather icon-plus"></i> Yeni Mahalle
                </button>

                @if (ViewBag.ShowDeleted == true)
                {
                    <button type="button" id="btn-toggle-deleted" class="btn btn-grd-warning waves-effect waves-light" style="margin-left: 5px;" data-show-deleted="true">
                        <span class="feather icon-eye-off"> Silinenleri Gizle</span>
                    </button>
                }
                else
                {
                    <button type="button" id="btn-toggle-deleted" class="btn btn-grd-inverse waves-effect waves-light" style="margin-left: 5px;" data-show-deleted="false">
                        <span class="feather icon-eye"> Silinenleri Göster</span>
                    </button>
                }
            </div>
        </div>
        <hr />
        
        <div class="dt-responsive table-responsive">
            <table id="neighborhood-table" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Ülke</th>
                        <th>Şehir</th>
                        <th>İlçe</th>
                        <th>Mahalle Adı</th>
                        <th>Posta Kodu</th>
                        <th>Notlar</th>
                        <th>Durum</th>
                        <th>Ekleyen</th>
                        <th>Ekleme Tarihi</th>
                        <th>Güncelleyen</th>
                        <th>Güncelleme Tarihi</th>
                        <th>Silen</th>
                        <th>Silinme Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody id="neighborhood-tbody">
                    <!-- Veriler AJAX ile yüklenecek -->
                </tbody>
            </table>
        </div>        
    </div>
    <br />
</div>

<!-- Create Neighborhood Modal -->
<div id="createNeighborhoodModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="login-card card-block login-card-modal">
            <form method="post" action="/Admin/Neighborhood/Create" class="md-float-material" id="createNeighborhoodForm">
                <div class="card m-t-15">
                    <div class="auth-box card-block">
                        <label class="btn btn-inverse btn-block p-t-15 p-b-15">Yeni Mahalle</label>
                        <div id="create-error-msg" class="alert alert-danger" style="display:none;"></div>
                        <br />

                        <div class="form-group m-b-10">
                            <label class="control-label"><strong>Ülke</strong></label>
                            <select id="create-country" class="form-control" required>
                                <option value="">-- Ülke Seçiniz --</option>
                                @foreach (var country in countries)
                                {
                                    <option value="@country.Id">@country.CountryName</option>
                                }
                            </select>
                        </div>

                        <div class="form-group m-b-10">
                            <label class="control-label"><strong>Şehir</strong></label>
                            <select id="create-city" class="form-control" required>
                                <option value="">-- Önce Ülke Seçiniz --</option>
                            </select>
                        </div>

                        <div class="form-group m-b-10">
                            <label class="control-label"><strong>İlçe</strong></label>
                            <select name="DistrictId" id="create-district" class="form-control" required>
                                <option value="">-- Önce Şehir Seçiniz --</option>
                            </select>
                        </div>

                        <div class="form-group m-b-10">
                            <label class="control-label"><strong>Mahalle Adı</strong></label>
                            <input type="text" name="NeighborhoodName" class="form-control" placeholder="Mahalle Adı" required minlength="3" />
                        </div>

                        <div class="form-group m-b-10">
                            <label class="control-label"><strong>Posta Kodu</strong></label>
                            @* <input type="text" name="PostalCode" class="form-control" placeholder="Posta Kodu" required pattern="\d{5,}" title="Posta kodu en az 5 rakam olmalıdır." /> *@
                            <input type="text" name="PostalCode" class="form-control" required pattern="\d{5}" maxlength="5" title="Posta kodu en az 5 rakam olmalıdır." placeholder="Posta Kodu" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                        </div>

                        <div class="form-group m-b-10">
                            <label class="control-label"><strong>Durum</strong></label>
                            <select name="IsActive" id="edit-isactive" class="form-control">
                                <option value="true">Aktif</option>
                                <option value="false">Pasif</option>
                            </select>
                        </div>

                        <div class="form-group m-b-10">
                            <label class="control-label"><strong>Notlar</strong></label>
                            <textarea name="Notes" class="form-control" placeholder="Notlar" rows="3"></textarea>
                        </div>
                        <input type="hidden" name="InsertUserId" value="00000000-0000-0000-0000-000000000000" />
                        <div class="row m-t-15">
                            <div class="col-md-4 text-center">
                                <button type="submit" class="btn btn-success btn-md btn-block">
                                    <i class="icofont icofont-check-circled"></i> Kaydet
                                </button>
                            </div>
                            <div class="col-md-4"></div>
                            <div class="col-md-4 text-right">
                                <button type="button" data-dismiss="modal" class="btn btn-danger btn-md btn-block">
                                    <i class="icofont icofont-ui-close"></i> Vazgeç
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Neighborhood Modal -->
