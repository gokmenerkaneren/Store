@model Store.DtoLayer.CatalogDtos.BrandDtos.UpdateBrandDto
@{
    bool isEdit = Model != null && Model.Id != Guid.Empty;
    ViewData["Title"] = "Yeni Marka";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card-block">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
                    <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
                        <div class="d-flex align-items-center">
                            <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                            <div style="margin-left: 10px;">
                                <h4 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                                    @(isEdit ? "Marka Güncelleme" : "Yeni Marka Ekle")
                                </h4>
                                <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">
                                    Aşağıdaki form üzerinden marka bilgilerini kaydedebilirsiniz.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br />
                <div class="card-block">
                    <form method="post" asp-action="@(isEdit ? "UpdateBrand" : "AddorEdit")" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Id" />
                        }

                        <div class="row">
                            <div class="col-sm-12">

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label" style="font-weight: 600;">Marka Adı</label>
                                    <div class="col-sm-10">
                                        <input type="text" class="form-control" asp-for="Name" placeholder="Marka Adı" required />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label" style="font-weight: 600;">Marka Kodu</label>
                                    <div class="col-sm-10">
                                        <input type="text" class="form-control" asp-for="Code" placeholder="Marka Kodu" />
                                        <span asp-validation-for="Code" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label" style="font-weight: 600;">Aktif mi?</label>
                                    <div class="col-sm-10">
                                        <select class="form-control" asp-for="IsActive">
                                            <option value="true">Aktif</option>
                                            <option value="false">Pasif</option>
                                        </select>
                                        <span asp-validation-for="IsActive" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label" style="font-weight: 600;">Notlar</label>
                                    <div class="col-sm-10">
                                        <textarea class="form-control" asp-for="Notes" rows="3" placeholder="Notlarım"></textarea>
                                        <span asp-validation-for="Notes" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group row mt-4">
                            <div class="col-sm-12">
                                <div class="row">
                                    <label class="col-sm-2"></label>
                                    <div class="col-sm-10">
                                        <button type="submit" class="btn btn-success" style="background-color: #00bcd4; border-color: #00bcd4; min-width: 100px;"><i class="icofont icofont-check-circled"></i>@(isEdit ? "Güncelle" : "Kaydet")</button>
                                        <a href="/Admin/Brand/Index" class="btn btn-danger ml-2" style="background-color: #ff5370; border-color: #ff5370; min-width: 100px;"><i class="icofont icofont-ui-close"></i>Vazgeç</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
