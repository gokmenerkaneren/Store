@model List<Store.DtoLayer.CatalogDtos.BrandDtos.ResultBrandDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        MARKA İŞLEMLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Marka Listesi ve İşlemleri</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />
    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="basic-btn" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Kodu</th>
                        <th>Adı</th>
                        <th>Notlar</th>
                        <th>Ekleyen</th>
                        <th>Ekleme Tarihi</th>
                        <th>Değiştiren Kullanıcı</th>
                        <th>Değiştirilme Tarihi</th>
                        <th>Durum</th>
                        <th> </th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr style="@(item.IsDeleted ? "background-color:#c0392b; color:#fff; border-left:4px solid #922b21; font-weight:600;" : (!item.IsActive ? "opacity:0.6;background-color:#f8d7da;" : ""))">
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Notes</td>
                                <td>@item.InsertUserId</td>
                                <td>@item.InsertDate</td>
                                <td>@item.UpdateUserId</td>
                                <td>@item.UpdateDate</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" style="float: none;">
                                        <button type="button" class="btn btn-grd-success waves-effect waves-light" style="float: none;margin: 5px;"
                                                data-toggle="modal" data-target="#detailsModal"
                                                data-id="@item.Id" data-name="@item.Name" data-code="@item.Code"
                                                data-active="@item.IsActive"
                                                data-insuser="@item.InsertUserId" data-insdate="@item.InsertDate"
                                                data-upduser="@item.UpdateUserId" data-upddate="@item.UpdateDate"
                                                data-notes="@item.Notes">
                                            <i class="icofont icofont-file-text"></i>
                                        </button>

                                         @if (item.IsDeleted)
                                         {
                                             <a href="javascript:void(0);" data-url="/Admin/Brand/RestoreBrand/@item.Id" class="btn btn-grd-warning waves-effect waves-light btn-restore-confirm" style="float: none; margin: 5px; min-width: 70px; padding: 6px 16px;">
                                                 <i class="feather icon-rotate-ccw"></i> Geri Al
                                             </a>
                                         }
                                         else
                                         {
                                             <a href="/Admin/Brand/AddorEdit/@item.Id" class="btn btn-grd-info waves-effect waves-light" style="float: none;margin: 5px;">
                                                 <span class="feather icon-edit"></span>
                                             </a>

                                             <a href="javascript:void(0);" data-url="/Admin/Brand/DeleteBrand/@item.Id" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="float: none;margin: 5px;">
                                                 <span class="feather icon-trash"></span>
                                             </a>
                                         }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <a href="/Admin/Brand/AddorEdit" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px; background-color: #00bcd4; border-color: #00bcd4; color: white;">
                <span class="feather icon-plus"> Yeni Marka Ekle</span>
            </a>

            @if (ViewBag.ShowDeleted == true)
            {
                <a href="/Admin/Brand/Index?showDeleted=false" class="btn btn-grd-warning waves-effect waves-light" style="float: none;margin: 5px;">
                    <span class="feather icon-eye-off"> Silinenleri Gizle</span>
                </a>
            }
            else
            {
                <a href="/Admin/Brand/Index?showDeleted=true" class="btn btn-grd-inverse waves-effect waves-light" style="float: none;margin: 5px;">
                    <span class="feather icon-eye"> Silinenleri Göster</span>
                </a>
            }
        </div>
    </div>
</div>

<div id="detailsModal" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="login-card card-block login-card-modal">
            <div class="card m-t-15">
                <div class="auth-box card-block">
                    <div class="row m-b-20">
                        <div class="col-md-12">
                            <h3 class="text-center txt-primary">Marka Detayları</h3>
                        </div>
                    </div>
                    <hr>
                    <div class="row m-b-10">
                        <div class="col-sm-6"><strong>ID:</strong> <p id="det-id" class="text-muted"></p></div>
                        <div class="col-sm-6"><strong>Marka Adı:</strong> <p id="det-name" class="text-muted"></p></div>
                    </div>
                    <div class="row m-b-10">
                        <div class="col-sm-6"><strong>Kod:</strong> <p id="det-code" class="text-muted"></p></div>
                        <div class="col-sm-6"><strong>Durum:</strong> <p id="det-active" class="text-muted"></p></div>
                    </div>
                    <div class="row m-b-10">
                        <div class="col-md-12"><strong>Notlar:</strong> <p id="det-notes" class="text-muted" style="white-space: pre-line;"></p></div>
                    </div>
                    <hr>
                    <div class="row m-b-10">
                        <div class="col-sm-6"><strong>Ekleyen:</strong> <p id="det-insuser" class="text-muted"></p></div>
                        <div class="col-sm-6"><strong>Ekleme Tarihi:</strong> <p id="det-insdate" class="text-muted"></p></div>
                    </div>
                    <div class="row m-b-10">
                        <div class="col-sm-6"><strong>Güncelleyen:</strong> <p id="det-upduser" class="text-muted"></p></div>
                        <div class="col-sm-6"><strong>Güncelleme Tarihi:</strong> <p id="det-upddate" class="text-muted"></p></div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 text-center">
                            <button type="button" class="btn btn-inverse" data-dismiss="modal">Kapat</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            $('.btn-delete-confirm').on('click', function(e) {
                e.preventDefault();
                var url = $(this).data('url');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });

            $('.btn-restore-confirm').on('click', function(e) {
                e.preventDefault();
                var url = $(this).data('url');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu kaydı geri almak istediğinize emin misiniz?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Geri Al!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });

        $('#detailsModal').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);
            var modal = $(this);
            modal.find('#det-id').text(button.data('id'));
            modal.find('#det-code').text(button.data('code'));
            modal.find('#det-name').text(button.data('name'));

            var isActive = button.data('active') === 'True' || button.data('active') === true || button.data('active') === 'true';
            modal.find('#det-active').text(isActive ? 'Aktif' : 'Pasif');
            modal.find('#det-notes').text(button.data('notes'));
            modal.find('#det-insuser').text(button.data('insuser'));
            modal.find('#det-insdate').text(button.data('insdate'));
            modal.find('#det-upduser').text(button.data('upduser'));
            modal.find('#det-upddate').text(button.data('upddate'));
        });
    </script>
}
