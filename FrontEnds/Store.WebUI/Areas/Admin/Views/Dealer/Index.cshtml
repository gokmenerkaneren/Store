@model List<Store.DtoLayer.LocationDtos.DealerDtos.ResultDealerDto>
@{
    ViewData["Title"] = "Dealer Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">BAYİ İŞLEMLERİ</h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Bayi Listesi ve İşlemleri</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />
    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="dealer-table" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Bayi Adı</th>
                        <th>Vergi Dairesi</th>
                        <th>Vergi Numarası</th>
                        <th>İndirim Oranı</th>
                        <th>Kredi Limiti</th>
                        <th>Güncel Bakiye</th>
                        <th>İletişim Bilgileri</th>
                        <th>Aktif mi?</th>
                        <th>Notlar</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelleme Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
            <div class="mt-3">
                <a href="/Admin/Dealer/Add" class="btn btn-grd-primary waves-effect waves-light" style="margin:5px;">
                    <span class="feather icon-plus"></span> Yeni Bayi Ekle
                </a>
                @if (ViewBag.ShowDeleted == true)
                {
                    <a href="/Admin/Dealer/Index?showDeleted=false" class="btn btn-grd-warning waves-effect waves-light" style="margin:5px;">
                        <span class="feather icon-eye-off"></span> Aktif Kayıtları Göster
                    </a>
                }
                else
                {
                    <a href="/Admin/Dealer/Index?showDeleted=true" class="btn btn-grd-inverse waves-effect waves-light" style="margin:5px;">
                        <span class="feather icon-eye"></span> Silinmiş Kayıtları Göster
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #00bcd4; border-radius: 5px 5px 0 0;">
                <h5 class="modal-title"><i class="feather icon-info"></i> Dealer Detayları</h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-sm-6"><strong>Id:</strong> <p id="det-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Bayi Adı:</strong> <p id="det-company-name" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Vergi Dairesi:</strong> <p id="det-tax-office" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Vergi Numarası:</strong> <p id="det-tax-number" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>İndirim Oranı:</strong> <p id="det-discount-rate" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Kredi Limiti:</strong> <p id="det-credit-limit" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Güncel Bakiye:</strong> <p id="det-current-balance" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>İletişim Bilgileri:</strong> <p id="det-contact-info-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Aktif mi?:</strong> <p id="det-is-active" class="text-muted"></p></div>
                    <div class="col-sm-12"><strong>Notlar:</strong> <p id="det-notes" class="text-muted" style="white-space: pre-line;"></p></div>
                </div>
                <hr/>
                <div class="row">
                    <div class="col-sm-6"><strong>Ekleyen:</strong> <p id="det-insert-user-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Ekleme Tarihi:</strong> <p id="det-insert-date" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Güncelleyen:</strong> <p id="det-update-user-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Güncelleme Tarihi:</strong> <p id="det-update-date" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silinme Durumu:</strong> <p id="det-is-deleted" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silen:</strong> <p id="det-delete-user-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silinme Tarihi:</strong> <p id="det-delete-date" class="text-muted"></p></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-inverse" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var showDeleted = '@ViewBag.ShowDeleted' === 'True';
            
            var table = $('#dealer-table').DataTable({
                "processing": true,
                "serverSide": true,
                "filter": true,
                "orderMulti": false,
                "ajax": {
                    "url": "/Admin/Dealer/GetDataTablesData?showDeleted=" + showDeleted,
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "companyName", "name": "CompanyName", "autoWidth": true },
                    { "data": "taxOffice", "name": "TaxOffice", "autoWidth": true },
                    { "data": "taxNumber", "name": "TaxNumber", "autoWidth": true },
                    { "data": "discountRate", "name": "DiscountRate", "autoWidth": true },
                    { "data": "creditLimit", "name": "CreditLimit", "autoWidth": true },
                    { "data": "currentBalance", "name": "CurrentBalance", "autoWidth": true },
                    { "data": "contactInfoId", "name": "ContactInfoId", "autoWidth": true },
                    { 
                        "data": "isActive", 
                        "name": "IsActive", 
                        "render": function (data, type, row) {
                            if (row.isDeleted) return '<span class="label" style="background:#7b241c; color:#fff;">Silindi</span>';
                            return data ? '<span class="label label-success">Aktif</span>' : '<span class="label label-danger">Pasif</span>';
                        } 
                    },
                    { "data": "notes", "name": "Notes", "autoWidth": true },
                    { 
                        "data": "insertDate", 
                        "name": "InsertDate",
                        "render": function(data) { return data ? new Date(data).toLocaleString('tr-TR') : ''; }
                    },
                    { 
                        "data": "updateDate", 
                        "name": "UpdateDate",
                        "render": function(data) { return data ? new Date(data).toLocaleString('tr-TR') : ''; }
                    },
                    {
                        "data": "id",
                        "render": function (data, type, row) {
                            var btns = '<div class="btn-group btn-group-sm">';
                            btns += '<button type="button" class="btn btn-grd-success waves-effect waves-light" style="margin:5px;" ';
                            btns += 'data-toggle="modal" data-target="#detailsModal" ';
                            btns += 'data-id="'+row.id+'" data-company-name="'+row.companyName+'" data-tax-office="'+row.taxOffice+'" data-tax-number="'+row.taxNumber+'" ';
                            btns += 'data-discount-rate="'+row.discountRate+'" data-credit-limit="'+row.creditLimit+'" ';
                            btns += 'data-current-balance="'+row.currentBalance+'" data-contact-info-id="'+row.contactInfoId+'" ';
                            btns += 'data-is-active="'+row.isActive+'" data-notes="'+row.notes+'" ';
                            btns += 'data-insert-user-id="'+row.insertUserId+'" data-insert-date="'+(row.insertDate ? new Date(row.insertDate).toLocaleString('tr-TR') : '')+'" ';
                            btns += 'data-update-user-id="'+row.updateUserId+'" data-update-date="'+(row.updateDate ? new Date(row.updateDate).toLocaleString('tr-TR') : '')+'" ';
                            btns += 'data-is-deleted="'+row.isDeleted+'" data-delete-user-id="'+row.deleteUserId+'" data-delete-date="'+(row.deleteDate ? new Date(row.deleteDate).toLocaleString('tr-TR') : '')+'">';
                            btns += '<i class="icofont icofont-file-document"></i></button>';

                            if (row.isDeleted) {
                                btns += '<a href="/Admin/Dealer/RestoreDealer/'+data+'" class="btn btn-grd-warning waves-effect waves-light btn-restore-confirm" style="margin:5px; min-width: 70px; padding: 6px 16px;"><i class="feather icon-rotate-ccw"></i> Geri Al</a>';
                            } else {
                                btns += '<a href="/Admin/Dealer/Edit/'+data+'" class="btn btn-grd-info waves-effect waves-light" style="margin:5px;"><span class="feather icon-edit"></span></a>';
                                btns += '<a href="/Admin/Dealer/DeleteDealer/'+data+'" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="margin:5px;"><span class="feather icon-trash"></span></a>';
                            }
                            btns += '</div>';
                            return btns;
                        }
                    }
                ],
                "createdRow": function(row, data, dataIndex) {
                    if (data.isDeleted) {
                        $(row).attr('style', 'background-color:#c0392b; color:#fff; border-left:4px solid #922b21; font-weight:600;');
                    } else if (!data.isActive) {
                        $(row).attr('style', 'opacity:0.5;background-color:#f8d7da;');
                    }
                },
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Turkish.json"
                }
            });
        });

        $('#detailsModal').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);
            var modal = $(this);
            modal.find('#det-id').text(button.data('id'));
            modal.find('#det-company-name').text(button.data('company-name'));
            modal.find('#det-tax-office').text(button.data('tax-office'));
            modal.find('#det-tax-number').text(button.data('tax-number'));
            modal.find('#det-discount-rate').text(button.data('discount-rate'));
            modal.find('#det-credit-limit').text(button.data('credit-limit'));
            modal.find('#det-current-balance').text(button.data('current-balance'));
            modal.find('#det-contact-info-id').text(button.data('contact-info-id'));
            var isActive = button.data('is-active') === true || button.data('is-active') === 'true' || button.data('is-active') === 'True';
            modal.find('#det-is-active').text(isActive ? 'Evet' : 'Hayır');
            modal.find('#det-notes').text(button.data('notes'));
            modal.find('#det-insert-user-id').text(button.data('insert-user-id'));
            modal.find('#det-insert-date').text(button.data('insert-date'));
            modal.find('#det-update-user-id').text(button.data('update-user-id'));
            modal.find('#det-update-date').text(button.data('update-date'));
            var isDeleted = button.data('is-deleted') === true || button.data('is-deleted') === 'true' || button.data('is-deleted') === 'True';
            modal.find('#det-is-deleted').text(isDeleted ? 'Evet' : 'Hayır');
            modal.find('#det-delete-user-id').text(button.data('delete-user-id'));
            modal.find('#det-delete-date').text(button.data('delete-date'));
        });
    </script>
}

