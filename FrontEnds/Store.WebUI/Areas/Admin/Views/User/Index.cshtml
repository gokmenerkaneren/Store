@model List<Store.DtoLayer.IdentityDtos.UserDtos.ResultUserDto>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-users" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        KULLANICI İŞLEMLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Kullanıcı Listesi ve İşlemleri</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />

    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="user-table" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Kullanıcı Adı</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        int count = 0;
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td>@item.UserName</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Admin/User/CreateOrUpdateUser/@item.Id" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px;">
                                            <span class="icofont icofont-ui-edit"></span> Düzenle
                                        </a>
                                        <a href="/Admin/User/DeleteUser/@item.Id" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="float: none;margin: 5px;">
                                            <span class="feather icon-trash"></span> Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <a href="/Admin/User/CreateOrUpdateUser" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px;">
                <span class="feather icon-plus"> Yeni Kullanıcı Ekle</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#user-table').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
                order: []
            });

            $('.btn-delete-confirm').on('click', function(e) {
                e.preventDefault();
                var href = $(this).attr('href');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu kullanıcıyı silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'İptal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // We use a form post to delete securely
                        var form = $('<form action="' + href + '" method="post"></form>');
                        $('body').append(form);
                        form.submit();
                    }
                });
            });
        });
    </script>
}
