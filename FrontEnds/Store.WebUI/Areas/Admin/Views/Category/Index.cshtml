@model List<Store.DtoLayer.CatalogDtos.CategoryDtos.ResultCategoryDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<!-- HTML5 Export Buttons table start -->
<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        KATEGORİ İŞLEMLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Kategori Listesi ve İşlemleri</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />
    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="category-table" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        @*                         <th>ID</th> *@
                        <th>Resim</th>
                        <th>Üst Kategori Adı</th>
                        <th>Kodu</th>
                        <th>Adı</th>
                        <th>Notlar</th>
                        <th>Ekleyen</th>
                        <th>Ekleme Tarihi</th>
                        <th>Değiştiren</th>
                        <th>Değiştirilme Tarihi</th>
                        <th>Silen</th>
                        <th>Silinme Tarihi</th>
                        <th>Durum</th>
                        <th>İşlemler </th>
                    </tr>
                </thead>

                <!-- Tablo Verileri basılıyor.   -->
                <tbody>
                    <!-- Veriler DataTables AJAX tarafından doldurulacak -->
                </tbody>
            </table>

            <a href="/Admin/Category/AddorEdit" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px; background-color: #00bcd4; border-color: #00bcd4; color: white;">
                <span class="feather icon-plus"> Yeni Kategori Ekle</span>
            </a>

            @if (ViewBag.ShowDeleted == true)
            {
                <a href="/Admin/Category/Index?showDeleted=false" class="btn btn-grd-warning waves-effect waves-light" style="float: none;margin: 5px;">
                    <span class="feather icon-eye-off"> Silinenleri Gizle</span>
                </a>
            }
            else
            {
                <a href="/Admin/Category/Index?showDeleted=true" class="btn btn-grd-inverse waves-effect waves-light" style="float: none;margin: 5px;">
                    <span class="feather icon-eye"> Silinenleri Göster</span>
                </a>
            }
        </div>
    </div>
</div>

<!-- Kategori Detay Modalı -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #00bcd4; border-radius: 5px 5px 0 0;">
                <h5 class="modal-title"><i class="feather icon-info"></i> Kategori Detayları</h5>
            </div>
            <div class="modal-body p-4">
                <div class="row m-b-10">
                    <div class="col-sm-6"><strong>ID:</strong> <p id="det-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Kategori Adı:</strong> <p id="det-name" class="text-muted"></p></div>
                </div>
                <div class="row m-b-10">
                    <div class="col-sm-6"><strong>Kod:</strong> <p id="det-code" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Üst Kategori:</strong> <p id="det-parent" class="text-muted"></p></div>
                </div>

                <div class="row m-b-10">
                    <div class="col-sm-12"><strong>Notlar:</strong> <p id="det-notes" class="text-muted" style="white-space: pre-line;"></p></div>
                </div>
                <hr>
                <div class="row m-b-10">
                    <div class="col-sm-6"><strong>Ekleyen:</strong> <p id="det-insuser" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Ekleme Tarihi:</strong> <p id="det-insdate" class="text-muted"></p></div>
                </div>
                <div class="row m-b-10">
                    <div class="col-sm-6"><strong>Güncelleyen:</strong> <p id="det-upduser" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Güncelleme Tarihi:</strong> <p id="det-upddate" class="text-muted"></p></div>
                </div>
                <div class="row m-b-10">
                    <div class="col-sm-6"><strong>Silen:</strong> <p id="det-deluser" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silinme Tarihi:</strong> <p id="det-deldate" class="text-muted"></p></div>
                </div>
                <div class="row m-b-10">
                    <div class="col-sm-6"><strong>Durum:</strong> <p id="det-active" class="text-muted"></p></div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal" style="color: white;"> <i class="icofont icofont-ui-close"></i> Kapat</button>
            </div>
        </div>
    </div>
</div>





@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var allCategoriesList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllCategories));
        
        function getCategoryStatusName(parentId) {
            if (!parentId) return 'Ana Kategori';
            
            var cat = allCategoriesList.find(c => c.Id === parentId || c.id === parentId);
            if (cat) {
                var name = cat.Name || cat.name;
                if (cat.IsDeleted || cat.isDeleted) {
                    name = ' <strong class="text-danger">(SİLİNMİŞ)-</strong>' + name;
                } else if (cat.IsActive === false || cat.isActive === false) {
                    name = ' <strong class="text-warning">(PASİF)-</strong>' + name;
                }
                return name;
            }
            return parentId;
        }

        $(document).ready(function() {
            $('#category-table').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
                serverSide: true,
                processing: true,
                ajax: {
                    url: '/Admin/Category/LoadDataTables?showDeleted=' + '@ViewBag.ShowDeleted'.toLowerCase(),
                    type: 'POST',
                    contentType: 'application/json',
                    data: function (d) {
                        return JSON.stringify(d);
                    }
                },
                columns: [
                    {
                        data: "imageUrl",
                        orderable: false,
                        render: function (data) {
                            if (data) {
                                return '<img src="' + data + '" alt="Kategori Resmi" style="height:40px; width:40px; object-fit:cover; border-radius:4px; border:1px solid #eee;" />';
                            }
                            return '<i class="feather icon-image" style="font-size:24px; color:#ccc;"></i>';
                        }
                    },
                    { data: "parentId", render: function (data) { return getCategoryStatusName(data); } },
                    { data: "code" },
                    { data: "name" },
                    { data: "notes" },
                    { data: "insertUserId" },
                    { data: "insertDate", render: function(data) { return data ? new Date(data).toLocaleString() : ''; } },
                    { data: "updateUserId" },
                    { data: "updateDate", render: function(data) { return data ? new Date(data).toLocaleString() : ''; } },
                    { data: "deleteUserId" },
                    { data: "deleteDate", render: function(data) { return data ? new Date(data).toLocaleString() : ''; } },
                    { 
                        data: "isActive", 
                        render: function (data) {
                            return data ? '<span class="label label-success">Aktif</span>' : '<span class="label label-danger">Pasif</span>';
                        }
                    },
                    {
                        data: "id",
                        orderable: false,
                        render: function (data, type, row) {
                            var isDeleted = row.isDeleted;
                            var btns = '<div class="btn-group btn-group-sm" style="float: none;">';
                            
                            btns += '<button type="button" class="btn btn-grd-success waves-effect waves-light" style="float: none;margin: 5px;" ' +
                                    'data-toggle="modal" data-target="#detailsModal" ' +
                                    'data-id="' + row.id + '" data-name="' + row.name + '" data-code="' + row.code + '" ' +
                                    'data-parentname="' + getCategoryStatusName(row.parentId).replace(/<[^>]*>?/gm, '') + '" ' +
                                    'data-active="' + row.isActive + '" ' +
                                    'data-insuser="' + (row.insertUserId || '-') + '" data-insdate="' + (row.insertDate ? new Date(row.insertDate).toLocaleString() : '-') + '" ' +
                                    'data-upduser="' + (row.updateUserId || '-') + '" data-upddate="' + (row.updateDate ? new Date(row.updateDate).toLocaleString() : '-') + '" ' +
                                    'data-deluser="' + (row.deleteUserId || '-') + '" data-deldate="' + (row.deleteDate ? new Date(row.deleteDate).toLocaleString() : '-') + '" ' +
                                    'data-notes="' + (row.notes || '-') + '">' +
                                    '<i class="icofont icofont-file-text"></i></button>';

                            if (isDeleted) {
                                btns += '<a href="javascript:void(0);" data-url="/Admin/Category/RestoreCategory/' + row.id + '" class="btn btn-grd-warning waves-effect waves-light btn-restore-confirm" style="float: none; margin: 5px; min-width: 70px; padding: 6px 16px;">' +
                                        '<i class="feather icon-rotate-ccw"></i> Geri Al</a>';
                            } else {
                                btns += '<a href="/Admin/Category/AddorEdit/' + row.id + '" class="btn btn-grd-info waves-effect waves-light" style="float: none;margin: 5px;">' +
                                        '<span class="feather icon-edit"></span></a>';
                                btns += '<a href="javascript:void(0);" data-url="/Admin/Category/DeleteCategory/' + row.id + '" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="float: none;margin: 5px;">' +
                                        '<span class="feather icon-trash"></span></a>';
                            }
                            btns += '</div>';
                            return btns;
                        }
                    }
                ],
                createdRow: function (row, data, dataIndex) {
                    if (data.isDeleted) {
                        $(row).attr('style', 'background-color:#c0392b; color:#fff; border-left:4px solid #922b21; font-weight:600;');
                    } else if (!data.isActive) {
                        $(row).attr('style', 'opacity:0.6;background-color:#f8d7da;');
                    }
                }
            });

            
            $(document).on('click', '.btn-delete-confirm', function(e) {
                e.preventDefault();
                var url = $(this).data('url');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });

            $(document).on('click', '.btn-restore-confirm', function(e) {
                e.preventDefault();
                var url = $(this).data('url');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu kaydı geri almak istediğinize emin misiniz?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Geri Al!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });

        $('#detailsModal').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);
            var modal = $(this);
            modal.find('#det-id').text(button.data('id'));
            modal.find('#det-code').text(button.data('code'));
            modal.find('#det-name').text(button.data('name'));
            modal.find('#det-parent').text(button.data('parentname') || 'Ana Kategori');

            modal.find('#det-insuser').text(button.data('insuser') || '-');
            modal.find('#det-insdate').text(button.data('insdate') || '-');
            modal.find('#det-upduser').text(button.data('upduser') || '-');
            modal.find('#det-upddate').text(button.data('upddate') || '-');
            modal.find('#det-deluser').text(button.data('deluser') || '-');
            modal.find('#det-deldate').text(button.data('deldate') || '-');

            var isActive = button.data('active') === 'True' || button.data('active') === true || button.data('active') === 'true';
            modal.find('#det-active').text(isActive ? 'Aktif' : 'Pasif');
            modal.find('#det-notes').text(button.data('notes') || '-');
        });
    </script>
}
