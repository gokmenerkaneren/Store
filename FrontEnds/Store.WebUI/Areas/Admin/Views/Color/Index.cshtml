@model List<Store.DtoLayer.CatalogDtos.ColorDtos.ResultColorDto>
@{
    ViewData["Title"] = "Renk Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    bool showDeleted = ViewBag.ShowDeleted == true;
}

<div class="card-block">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header bg-c-blue text-white"
                     style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
                    <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
                        <div class="d-flex align-items-center">
                            <i class="feather icon-droplet" style="font-size: 45px; color: #ffffff !important;"></i>
                            <div style="margin-left: 10px;">
                                <h4 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                                    Renk Yönetimi
                                </h4>
                                <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9);">
                                    Ürün varyantlarında kullanılacak renkleri buradan yönetebilirsiniz.
                                </div>
                            </div>
                        </div>
                        <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                            <ul class="list-unstyled card-option" style="margin: 0;">
                                <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                                <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                                <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <br />

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger m-3">
                        <i class="feather icon-alert-circle"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <div class="card-block">
                    <div class="dt-responsive table-responsive">
                        <table id="color-table" class="table table-striped table-bordered nowrap">
                            <thead>
                            <tr>
                                <th>Renk Önizleme</th>
                                <th>Renk Adı</th>
                                <th>Hex Kodu</th>
                                <th>Sıra</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model.OrderBy(x => x.DisplayOrder))
                                {
                                    <tr class="@(item.IsDeleted ? "table-danger" : "")">
                                        <td style="width: 80px; vertical-align: middle;">
                                            @if (!string.IsNullOrEmpty(item.HexCode))
                                            {
                                                <!-- Renk dairesi: HexCode'dan inline style ile üretilir -->
                                                <span style="display: inline-block; width: 36px; height: 36px; border-radius: 50%;
                                                             background-color: @item.HexCode; border: 2px solid #ccc;
                                                             box-shadow: 0 1px 4px rgba(0,0,0,0.2);" title="@item.HexCode">
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="display: inline-block; width: 36px; height: 36px; border-radius: 50%;
                                                             background-color: #e0e0e0; border: 2px solid #ccc;" title="Renk kodu yok">
                                                </span>
                                            }
                                        </td>
                                        <td style="vertical-align: middle;">@item.Name</td>
                                        <td style="vertical-align: middle;">
                                            <code>@(item.HexCode ?? "-")</code>
                                        </td>
                                        <td style="vertical-align: middle;">@item.DisplayOrder</td>
                                        <td style="vertical-align: middle;">
                                            @if (item.IsDeleted)
                                            {
                                                <span class="badge badge-danger">Silindi</span>
                                            }
                                            else if (item.IsActive)
                                            {
                                                <span class="badge badge-success">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">Pasif</span>
                                            }
                                        </td>
                                        <td style="vertical-align: middle;">
                                            <div class="d-flex flex-wrap">
                                                @if (item.IsDeleted)
                                                {
                                                    <a href="javascript:void(0);"
                                                       data-url="/Admin/Color/RestoreColor/@item.Id"
                                                       class="btn btn-grd-warning waves-effect waves-light btn-restore-confirm"
                                                       style="margin: 3px;">
                                                        <i class="feather icon-rotate-ccw"></i> Geri Al
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="/Admin/Color/AddorEdit/@item.Id"
                                                       class="btn btn-grd-info waves-effect waves-light"
                                                       style="margin: 3px;">
                                                        <span class="feather icon-edit"></span>
                                                    </a>
                                                    <a href="javascript:void(0);"
                                                       data-url="/Admin/Color/DeleteColor/@item.Id"
                                                       class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm"
                                                       style="margin: 3px;">
                                                        <span class="feather icon-trash"></span>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        </table>

                        <a href="/Admin/Color/AddorEdit" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px;">
                            <span class="feather icon-plus"> Yeni Renk Ekle</span>
                        </a>

                        @if (showDeleted)
                        {
                            <a href="/Admin/Color/Index?showDeleted=false" class="btn btn-grd-warning waves-effect waves-light" style="float: none;margin: 5px;">
                                <span class="feather icon-eye-off"> Silinenleri Gizle</span>
                            </a>
                        }
                        else
                        {
                            <a href="/Admin/Color/Index?showDeleted=true" class="btn btn-grd-inverse waves-effect waves-light" style="float: none;margin: 5px;">
                                <span class="feather icon-eye"> Silinenleri Göster</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            $('#color-table').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
                order: []
            });

            $('.btn-delete-confirm').on('click', function (e) {
                e.preventDefault();
                var url = $(this).data('url');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu rengi silmek istediğinize emin misiniz?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Sil!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) { window.location.href = url; }
                });
            });

            $('.btn-restore-confirm').on('click', function (e) {
                e.preventDefault();
                var url = $(this).data('url');
                Swal.fire({
                    title: 'Emin misiniz?',
                    text: "Bu rengi geri almak istediğinize emin misiniz?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Evet, Geri Al!',
                    cancelButtonText: 'Vazgeç'
                }).then((result) => {
                    if (result.isConfirmed) { window.location.href = url; }
                });
            });
        });
    </script>
}
