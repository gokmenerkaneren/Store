
@model List<Store.DtoLayer.LocationDtos.BranchDtos.ResultBranchDto>
@{
    ViewData["Title"] = "Şube Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var companies = ViewBag.Companies as List<Store.DtoLayer.LocationDtos.CompanyDtos.ResultCompanyDto> ?? new List<Store.DtoLayer.LocationDtos.CompanyDtos.ResultCompanyDto>();
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        ŞUBE İŞLEMLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Şube Listesi ve İşlemleri</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />

    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="branch-table" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Adı</th>
                        <th>Şube Tipi</th>
                        <th>Şirket</th>
                        <th>Koordinatlar</th>
                        <th>Durum</th>
                        <th>Notlar</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelleme Tarihi</th>
                        <th>Silinme Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            var companyName = companies.FirstOrDefault(c => c.Id == item.CompanyId)?.LegalName ?? item.CompanyId.ToString();
                            <tr style="@(item.IsDeleted ? "background-color:#c0392b; color:#fff; border-left:4px solid #922b21; font-weight:600;" : (!item.IsActive ? "opacity:0.5;background-color:#f8d7da;" : ""))">
                                <td style="@(item.IsDeleted ? "text-decoration:line-through;" : "")">@item.Name</td>
                                <td style="@(item.IsDeleted ? "text-decoration:line-through;" : "")">@item.BranchType</td>
                                <td>@companyName</td>
                                <td>@item.GeoLocationCoordinates</td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <span class="label" style="background:#7b241c; color:#fff;">Silindi</span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="label label-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Pasif</span>
                                    }
                                </td>
                                @* <td style="white-space: pre-line;">@item.Notes</td>  Açıklamayı satır satır gösterir*@
                                <td>@item.Notes</td>
                                <td>@item.InsertDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                <td>@(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm:ss"))</td>
                                <td>@(item.DeleteDate?.ToString("dd.MM.yyyy HH:mm:ss"))</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <!-- Detay Butonu -->
                                        <button type="button" class="btn btn-grd-success waves-effect waves-light" style="float: none;margin: 5px;"
                                                data-toggle="modal" data-target="#detailsModal"
                                                data-id="@item.Id" data-name="@item.Name" data-branch-type="@item.BranchType"
                                                data-company-id="@item.CompanyId" data-company-name="@companyName"
                                                data-contact-info-id="@item.ContactInfoId" data-geo-location-coordinates="@item.GeoLocationCoordinates"
                                                data-is-active="@item.IsActive" data-notes="@item.Notes"
                                                data-insert-user-id="@item.InsertUserId" data-insert-date="@item.InsertDate.ToString("dd.MM.yyyy HH:mm:ss")"
                                                data-update-user-id="@item.UpdateUserId" data-update-date="@(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm:ss"))"
                                                data-is-deleted="@item.IsDeleted"
                                                data-delete-user-id="@item.DeleteUserId" data-delete-date="@(item.DeleteDate?.ToString("dd.MM.yyyy HH:mm:ss"))">
                                            <i class="icofont icofont-file-document"></i>
                                        </button>

                                        @if (item.IsDeleted)
                                        {
                                            <!-- Geri Alma Butonu -->
                                            <a href="/Admin/Branch/RestoreBranch/@item.Id" class="btn btn-grd-warning waves-effect waves-light btn-restore-confirm" style="float: none; margin: 5px; min-width: 70px; padding: 6px 16px;">
                                                <i class="feather icon-rotate-ccw"></i> Geri Al
                                            </a>
                                        }
                                        else
                                        {
                                            <!-- Güncelle Butonu -->
                                            <a href="/Admin/Branch/Edit/@item.Id" class="btn btn-grd-info waves-effect waves-light" style="float: none;margin: 5px;">
                                                <span class="feather icon-edit"></span>
                                            </a>

                                            <!-- Sil Butonu -->
                                            <a href="/Admin/Branch/DeleteBranch/@item.Id" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="float: none;margin: 5px;">
                                                <span class="feather icon-trash"></span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div>
                <a href="/Admin/Branch/Add" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px;">
                    <span class="feather icon-plus"> Yeni Şube Ekle</span>
                </a>

                @if (ViewBag.ShowDeleted == true)
                {
                    <a href="/Admin/Branch/Index?showDeleted=false" class="btn btn-grd-warning waves-effect waves-light" style="float: none;margin: 5px;">
                        <span class="feather icon-eye-off"> Silinenleri Gizle</span>
                    </a>
                }
                else
                {
                    <a href="/Admin/Branch/Index?showDeleted=true" class="btn btn-grd-inverse waves-effect waves-light" style="float: none;margin: 5px;">
                        <span class="feather icon-eye"> Silinenleri Göster</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #00bcd4; border-radius: 5px 5px 0 0;">
                <h5 class="modal-title"><i class="feather icon-info"></i> Şube Detayları</h5>
               @*  <button type="button" class="close text-white" data-dismiss="modal">&times;</button> *@
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-sm-6"><strong>Id:</strong> <p id="det-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Şube Adı:</strong> <p id="det-name" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Şube Tipi:</strong> <p id="det-branchType" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Şirket:</strong> <p id="det-companyName" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Koordinatlar:</strong> <p id="det-geoLocationCoordinates" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Durum:</strong> <p id="det-isActive" class="text-muted"></p></div>
                    <div class="col-sm-12"><strong>Notlar:</strong> <p id="det-notes" class="text-muted" style="white-space: pre-line;"></p></div>
                </div>
                <hr/>
                <div class="row">
                    <div class="col-sm-6"><strong>Ekleyen:</strong> <p id="det-insertUserId" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Ekleme Tarihi:</strong> <p id="det-insertDate" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Güncelleyen:</strong> <p id="det-updateUserId" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Güncelleme Tarihi:</strong> <p id="det-updateDate" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silinme Durumu:</strong> <p id="det-isDeleted" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silen:</strong> <p id="det-deleteUserId" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silinme Tarihi:</strong> <p id="det-deleteDate" class="text-muted"></p></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal" style="color: white;"> <i class="icofont icofont-ui-close"></i> Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#branch-table').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
                order: []
            });
        });

        $('#detailsModal').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);
            var modal = $(this);
            modal.find('#det-id').text(button.data('id'));
            modal.find('#det-name').text(button.data('name'));
            modal.find('#det-branchType').text(button.data('branch-type'));
            modal.find('#det-companyName').text(button.data('company-name'));
            modal.find('#det-geoLocationCoordinates').text(button.data('geo-location-coordinates'));
            var isActive = button.data('is-active') === 'True' || button.data('is-active') === true || button.data('is-active') === 'true';
            modal.find('#det-isActive').text(isActive ? 'Aktif' : 'Pasif');
            modal.find('#det-notes').text(button.data('notes'));
            modal.find('#det-insertUserId').text(button.data('insert-user-id'));
            modal.find('#det-insertDate').text(button.data('insert-date'));
            modal.find('#det-updateUserId').text(button.data('update-user-id'));
            modal.find('#det-updateDate').text(button.data('update-date'));
            var isDeleted = button.data('is-deleted') === 'True' || button.data('is-deleted') === true || button.data('is-deleted') === 'true';
            modal.find('#det-isDeleted').text(isDeleted ? 'Evet' : 'Hayır');
            modal.find('#det-deleteUserId').text(button.data('delete-user-id'));
            modal.find('#det-deleteDate').text(button.data('delete-date'));
        });
    </script>
}

