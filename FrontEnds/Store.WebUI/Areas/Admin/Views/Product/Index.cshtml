@model List<Store.DtoLayer.CatalogDtos.ProductDtos.ResultProductDto>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="card">
    <div class="card-header bg-c-blue text-white" style="background-color: #00bcd4 !important; border-radius: 5px 5px 0 0; margin-bottom: 0; padding: 15px 25px;">
        <div class="d-flex align-items-center justify-content-between" style="width: 100%;">
            <div class="d-flex align-items-center">
                <i class="feather icon-download-cloud" style="font-size: 45px; color: #ffffff !important;"></i>
                <div style="margin-left: 10px;">
                    <h3 class="m-b-0" style="font-weight: 600; font-size: 28px; line-height: 1; color: #ffffff !important;">
                        ÜRÜN İŞLEMLERİ
                    </h3>
                    <div class="m-t-5" style="font-size: 14px; color: rgba(255,255,255,0.9); padding-left: 0;">Ürün Listesi ve İşlemleri</div>
                </div>
            </div>
            <div class="card-header-right" style="position: relative; right: auto; top: auto; float: none; padding: 0;">
                <ul class="list-unstyled card-option" style="margin: 0;">
                    <li><i class="feather icon-maximize full-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-minus minimize-card" style="color: #ffffff !important;"></i></li>
                    <li><i class="feather icon-trash-2 close-card" style="color: #ffffff !important;"></i></li>
                </ul>
            </div>
        </div>
    </div>
    <br />

    <div class="card-block">
        <div class="dt-responsive table-responsive">
            <table id="product-table" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Kategori</th>
                        <th>Ürün Kodu</th>
                        <th>Ürün Adı</th>
                        <th>Vitrin Resmi</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        int count = 0;
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr style="@(item.IsDeleted ? "background-color:#c0392b; color:#fff; border-left:4px solid #922b21; font-weight:600;" : (!item.IsActive ? "opacity:0.5;background-color:#f8d7da;" : ""))">
                                <td>@count</td>
                                @{
                                    var categoryList = ViewBag.AllCategories as List<Store.DtoLayer.CatalogDtos.CategoryDtos.ResultCategoryDto>;
                                    var cat = categoryList?.FirstOrDefault(c => c.Id == item.CategoryId);
                                    var categoryName = cat?.Name ?? item.CategoryId.ToString() ?? "-";
                                    var rawCategoryName = categoryName;

                                    if (cat != null) {
                                        if (cat.IsDeleted) {
                                            rawCategoryName = $"<strong class=\"text-danger\">(SİLİNMİŞ)</strong> - {categoryName}";
                                        } else if (!cat.IsActive) {
                                            rawCategoryName = $"<strong class=\"text-warning\">(PASİF)</strong> - {categoryName}";
                                        }
                                    }

                                    var brandList = ViewBag.AllBrands as List<Store.DtoLayer.CatalogDtos.BrandDtos.ResultBrandDto>;
                                    var brand = brandList?.FirstOrDefault(b => b.Id == item.BrandId);
                                    var brandName = brand?.Name ?? (item.BrandId?.ToString() ?? "-");
                                    var rawBrandName = brandName;
                                    
                                    if (brand != null) {
                                        if (brand.IsDeleted) {
                                            rawBrandName = $"<strong class=\"text-danger\">(SİLİNMİŞ)</strong> - {brandName}";
                                        } else if (!brand.IsActive) {
                                            rawBrandName = $"<strong class=\"text-warning\">(PASİF)</strong> - {brandName}";
                                        }
                                    }
                                }
                                <td style="@(item.IsDeleted ? "text-decoration:line-through;" : "")">@Html.Raw(rawCategoryName)</td>
                                <td>@item.ProductCode</td>
                                <td>@item.Name</td>
                                <td class="text-center" style="vertical-align: middle; padding: 0; width: 100px; height: 60px;">
                                    @{
                                        var mainImages = ViewBag.MainImages as Dictionary<Guid, string>;
                                        var imageUrl = mainImages != null && mainImages.ContainsKey(item.Id) ? mainImages[item.Id] : null;
                                    }
                                    @if (!string.IsNullOrEmpty(imageUrl))
                                    {
                                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: white; border-radius: 4px;">
                                            <img src="@imageUrl" alt="Vitrin" style="max-width: 100%; max-height: 100%; object-fit: contain; padding: 4px;" />
                                        </div>
                                    }
                                </td>
                                @* <td>@item.Id</td>  Kategori adını getirmek için bir join gerekebilir ama şimdilik ID *@
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <!-- Detay Butonu -->
                                        <button type="button" class="btn btn-grd-success waves-effect waves-light" style="float: none;margin: 5px;"
                                                data-toggle="modal" data-target="#detailsProductModal"
                                                data-id="@item.Id" 
                                                data-productcode="@item.ProductCode" 
                                                data-name="@item.Name" 
                                                data-description="@item.Description" 
                                                data-categoryname="@categoryName" 
                                                data-brandname="@brandName" 
                                                data-price="@item.Price" 
                                                data-is-active="@item.IsActive" 
                                                data-notes="@item.Notes"
                                                data-insert-user-id="@item.InsertUserId" 
                                                data-insert-date="@item.InsertDate.ToString("dd.MM.yyyy HH:mm:ss")"
                                                data-update-user-id="@item.UpdateUserId" 
                                                data-update-date="@(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm:ss"))"
                                                data-is-deleted="@item.IsDeleted"
                                                data-delete-user-id="@item.DeleteUserId" 
                                                data-delete-date="@(item.DeleteDate?.ToString("dd.MM.yyyy HH:mm:ss"))">
                                            <i class="icofont icofont-file-document"></i>
                                        </button>

                                        @if (item.IsDeleted)
                                        {
                                            <a href="/Admin/Product/RestoreProduct/@item.Id" class="btn btn-grd-warning waves-effect waves-light btn-restore-confirm" style="float: none; margin: 5px; min-width: 70px; padding: 6px 16px;">
                                                <i class="feather icon-rotate-ccw"></i> Geri Al
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="/Admin/Product/CreateOrUpdateProduct/@item.Id" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px;">
                                                <span class="icofont icofont-ui-edit"></span>
                                            </a>
                                            <a href="/Admin/Product/DeleteProduct/@item.Id" class="btn btn-grd-danger waves-effect waves-light btn-delete-confirm" style="float: none;margin: 5px;">
                                                <span class="feather icon-trash"></span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <a href="/Admin/Product/CreateOrUpdateProduct" class="btn btn-grd-primary waves-effect waves-light" style="float: none;margin: 5px;">
                <span class="feather icon-plus"> Yeni Ürün</span>
            </a>

            @if (ViewBag.ShowDeleted == true)
            {
                <a href="/Admin/Product/Index?showDeleted=false" class="btn btn-grd-warning waves-effect waves-light" style="float: none;margin: 5px;">
                    <span class="feather icon-eye-off"> Silinenleri Gizle</span>
                </a>
            }
            else
            {
                <a href="/Admin/Product/Index?showDeleted=true" class="btn btn-grd-inverse waves-effect waves-light" style="float: none;margin: 5px;">
                    <span class="feather icon-eye"> Silinenleri Göster</span>
                </a>
            }
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsProductModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #00bcd4; border-radius: 5px 5px 0 0;">
                <h5 class="modal-title"><i class="feather icon-info"></i> Ürün Detayları</h5>
                @* <button type="button" class="close text-white" data-dismiss="modal">&times;</button> *@
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-sm-6"><strong>Id</strong> <p id="det-id" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Ürün Kodu</strong> <p id="det-productcode" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Ürün Adı</strong> <p id="det-name" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Açıklama</strong> <p id="det-description" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Kategori</strong> <p id="det-categoryname" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Marka</strong> <p id="det-brandname" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Fiyat</strong> <p id="det-price" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Aktif mi?</strong> <p id="det-isActive" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Notlar</strong> <p id="det-notes" class="text-muted" style="white-space: pre-line;"></p></div>
                </div>
                <hr/>
                <div class="row">
                    <div class="col-sm-6"><strong>Kaydeden Kullanıcı</strong> <p id="det-insertUserId" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Kayıt Tarihi</strong> <p id="det-insertDate" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Değiştiren Kullanıcı</strong> <p id="det-updateUserId" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Değiştirilme Tarihi</strong> <p id="det-updateDate" class="text-muted"></p></div>
                    <div class="col-sm-12"><strong>Silinmiş mi?</strong> <p id="det-isDeleted" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silen Kullanıcı</strong> <p id="det-deleteUserId" class="text-muted"></p></div>
                    <div class="col-sm-6"><strong>Silinme Tarihi</strong> <p id="det-deleteDate" class="text-muted"></p></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal" style="color: white;"> <i class="icofont icofont-ui-close"></i> Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#product-table').DataTable({
                dom: 'Bfrtip',
                buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
                order: []
            });
        });

        $('#detailsProductModal').on('show.bs.modal', function(event) {
            var button = $(event.relatedTarget);
            var modal = $(this);
            modal.find('#det-id').text(button.data('id'));
            modal.find('#det-productcode').text(button.data('productcode'));
            modal.find('#det-name').text(button.data('name'));
            modal.find('#det-description').text(button.data('description'));
            modal.find('#det-categoryname').text(button.data('categoryname'));
            modal.find('#det-brandname').text(button.data('brandname'));
            modal.find('#det-price').text(button.data('price') + ' ₺');
            
            var isActive = button.data('is-active') === 'True' || button.data('is-active') === true || button.data('is-active') === 'true';
            modal.find('#det-isActive').text(isActive ? 'Evet' : 'Hayır');
            
            var isDeleted = button.data('is-deleted') === 'True' || button.data('is-deleted') === true || button.data('is-deleted') === 'true';
            modal.find('#det-isDeleted').text(isDeleted ? 'Evet' : 'Hayır');

            modal.find('#det-notes').text(button.data('notes'));
            modal.find('#det-insertUserId').text(button.data('insert-user-id'));
            modal.find('#det-insertDate').text(button.data('insert-date'));
            modal.find('#det-updateUserId').text(button.data('update-user-id'));
            modal.find('#det-updateDate').text(button.data('update-date'));
            modal.find('#det-deleteUserId').text(button.data('delete-user-id'));
            modal.find('#det-deleteDate').text(button.data('delete-date'));
        });
    </script>
}